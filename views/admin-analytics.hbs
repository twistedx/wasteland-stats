<style>
.coin-flags-accordion { border: 1px solid var(--border); border-radius: 8px; background: var(--bg-card); }
.coin-flags-summary { display: flex; align-items: center; padding: 0.75rem 1rem; cursor: pointer; user-select: none; font-weight: 700; font-family: 'Orbitron', sans-serif; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--accent); list-style: none; }
.coin-flags-summary::-webkit-details-marker { display: none; }
.coin-flags-summary::after { content: "\25BE"; margin-left: auto; color: var(--text-secondary); transition: transform 0.2s; }
details[open] .coin-flags-summary::after { transform: rotate(180deg); }
.coin-flags-body { padding: 0 1rem 1rem; }
</style>
<script>window.__dailyViews = {{{dailyViewsJson}}};window.__discord = {{{discordJson}}};window.__onlineHistory = {{{onlineHistoryJson}}};window.__storeStats = {{{storeStatsJson}}};window.__economyHistory = {{{economyHistoryJson}}};</script>
<script src="https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js"></script>
<script src="/js/admin-charts.js?v=2026-04-24"></script>

<script>
(function() {
  var discordChartsRendered = false;
  var atmChartRendered = false;

  document.querySelectorAll('.analytics-tab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      document.querySelectorAll('.analytics-tab').forEach(function(t) { t.classList.remove('active'); });
      this.classList.add('active');
      document.getElementById('tab-website').style.display = 'none';
      document.getElementById('tab-discord').style.display = 'none';
      var storeEl = document.getElementById('tab-store');
      if (storeEl) storeEl.style.display = 'none';
      var auditEl = document.getElementById('tab-audit');
      if (auditEl) auditEl.style.display = 'none';
      var atmEl = document.getElementById('tab-atm');
      if (atmEl) atmEl.style.display = 'none';
      var profileEl = document.getElementById('tab-profile');
      if (profileEl) profileEl.style.display = 'none';
      var securityEl = document.getElementById('tab-security');
      if (securityEl) securityEl.style.display = 'none';
      var coinsEl = document.getElementById('tab-coins');
      if (coinsEl) coinsEl.style.display = 'none';
      var outfitsEl = document.getElementById('tab-outfits');
      if (outfitsEl) outfitsEl.style.display = 'none';
      var pollsEl = document.getElementById('tab-polls');
      if (pollsEl) pollsEl.style.display = 'none';
      var rulesEl = document.getElementById('tab-rules');
      if (rulesEl) rulesEl.style.display = 'none';
      var playtimeEl = document.getElementById('tab-playtime');
      if (playtimeEl) playtimeEl.style.display = 'none';
      var visitorsEl = document.getElementById('tab-visitors');
      if (visitorsEl) visitorsEl.style.display = 'none';
      document.getElementById(this.getAttribute('data-tab')).style.display = '';

      // Update URL to reflect current tab and strip ATM-specific params
      var tabName = this.getAttribute('data-tab').replace('tab-', '');
      var newUrl = window.location.pathname + '?tab=' + tabName;
      if (tabName === 'atm') {
        var currentDays = new URLSearchParams(window.location.search).get('atmDays');
        if (currentDays) newUrl += '&atmDays=' + currentDays;
      }
      history.replaceState(null, '', newUrl);

      // Render Discord charts on first tab switch (ECharts needs visible container)
      // Render ATM chart on first tab switch
      if (this.getAttribute('data-tab') === 'tab-atm' && !atmChartRendered && window.__economyHistory && window.__economyHistory.length) {
        atmChartRendered = true;
        setTimeout(function() {
          var el = document.getElementById('chart-atm');
          if (!el || typeof echarts === 'undefined') return;
          var chart = echarts.init(el);
          var history = window.__economyHistory;
          var months = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
          var labels = history.map(function(d) { var p = d.date.split("-"); return months[parseInt(p[1],10)-1] + " " + parseInt(p[2],10); });
          chart.setOption({
            tooltip: { trigger: "axis" },
            legend: { data: ["Deposits", "Withdrawals"], textStyle: { color: "#aaa" }, top: 0 },
            xAxis: { type: "category", data: labels, axisLabel: { color: "#aaa", fontSize: 10, rotate: 35 }, axisLine: { lineStyle: { color: "#333" } } },
            yAxis: { type: "value", axisLabel: { color: "#aaa" }, splitLine: { lineStyle: { color: "#222" } } },
            series: [{
              name: "Deposits", type: "bar", data: history.map(function(d) { return d.deposits; }),
              itemStyle: { color: "#22c55e", borderRadius: [3,3,0,0] }, barMaxWidth: 20
            }, {
              name: "Withdrawals", type: "bar", data: history.map(function(d) { return d.withdrawals; }),
              itemStyle: { color: "#ef4444", borderRadius: [3,3,0,0] }, barMaxWidth: 20
            }]
          });
          window.addEventListener('resize', function() { chart.resize(); });
        }, 50);
      }

      if (this.getAttribute('data-tab') === 'tab-discord' && !discordChartsRendered && window.__discord && window.__discord.joinHistory) {
        discordChartsRendered = true;
        setTimeout(function() { window.dispatchEvent(new Event('resize')); }, 50);
      }
    });
  });

  // Auto-switch to tab from URL param
  var urlTab = new URLSearchParams(window.location.search).get('tab');
  if (urlTab) {
    var targetTab = document.querySelector('.analytics-tab[data-tab="tab-' + urlTab + '"]');
    if (targetTab) targetTab.click();
  }

  // Format visitor first_seen/last_seen timestamps (numeric epoch ms)
  document.querySelectorAll('.visitor-ts').forEach(function(el) {
    var ts = parseInt(el.dataset.ts, 10);
    if (!ts || isNaN(ts)) return;
    var d = new Date(ts);
    var ms = Date.now() - ts;
    var mins = Math.floor(ms / 60000);
    var hrs = Math.floor(ms / 3600000);
    var days = Math.floor(ms / 86400000);
    var ago = mins < 60 ? mins + 'm' : hrs < 24 ? hrs + 'h' : days + 'd';
    el.textContent = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) + ' ' + d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) + ' (' + ago + ' ago)';
  });

  // Format "Last Seen" cells as relative time
  document.querySelectorAll('.last-seen').forEach(function(el) {
    var iso = el.dataset.ts;
    if (!iso || iso === 'null' || iso === '') return;
    var d = new Date(iso);
    if (isNaN(d)) return;
    var ms = Date.now() - d.getTime();
    var mins = Math.floor(ms / 60000);
    var hrs = Math.floor(ms / 3600000);
    var days = Math.floor(ms / 86400000);
    var ago = mins < 60 ? mins + 'm ago' : hrs < 24 ? hrs + 'h ago' : days + 'd ago';
    el.textContent = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) + ' (' + ago + ')';
  });

  // Format "First Seen" cells as date + relative duration
  document.querySelectorAll('.first-seen').forEach(function(el) {
    var iso = el.dataset.ts;
    if (!iso || iso === 'null' || iso === '') return;
    var d = new Date(iso);
    if (isNaN(d)) return;
    var days = Math.floor((Date.now() - d.getTime()) / 86400000);
    var years = Math.floor(days / 365);
    var months = Math.floor((days % 365) / 30);
    var ago = years > 0 ? years + 'y ' + months + 'mo' : months > 0 ? months + 'mo' : days + 'd';
    el.textContent = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) + ' (' + ago + ')';
  });

  // Format "Guild Joined" cells as relative durations
  document.querySelectorAll('.guild-joined').forEach(function(el) {
    var iso = el.dataset.joined;
    if (!iso) return;
    var d = new Date(iso);
    if (isNaN(d)) return;
    var ms = Date.now() - d.getTime();
    var days = Math.floor(ms / 86400000);
    var years = Math.floor(days / 365);
    var months = Math.floor((days % 365) / 30);
    var label;
    if (years > 0) label = years + 'y ' + months + 'mo';
    else if (months > 0) label = months + 'mo ' + (days % 30) + 'd';
    else label = days + 'd';
    var color = days >= 90 ? '#22c55e' : days >= 30 ? '#fbbf24' : '#ef4444';
    var joinDate = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    el.innerHTML = '<span style="color:' + color + ';font-weight:700;">' + label + '</span> <span style="color:var(--text-secondary);">(' + joinDate + ')</span>';
  });

})();
</script>

