        <table>
          <thead>
            <tr>
              <th>Country</th>
              <th>IP</th>
              <th>User</th>
              <th style="text-align:right;">Visits</th>
              <th>First Seen</th>
              <th>Last Seen</th>
              <th>Recent Pages</th>
            </tr>
          </thead>
