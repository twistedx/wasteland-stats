                        <td style="font-size:0.75rem;color:var(--text-secondary);">{{this.voted_at}}</td>
                      </tr>
                    {{/each}}
                  </tbody>
                </table>
              </div>
            </details>
          {{/if}}

          {{#if (eq this.status 'open')}}
            <form method="POST" action="/admin/polls/{{this.id}}/close" style="margin-top:0.75rem;">
