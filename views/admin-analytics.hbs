                  <td style="font-weight:700;color:{{#if (lte @index 2)}}#fbbf24{{else}}var(--text-primary){{/if}};">#{{add @index 1}}</td>
                  <td class="player-name">
                    {{#if this.arma_id}}
                      <a href="/admin/player/{{this.arma_id}}" style="color:var(--accent);text-decoration:none;">{{this.arma_username}}</a>
                    {{else}}
                      {{this.arma_username}}
                    {{/if}}
