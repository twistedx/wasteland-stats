            </form>
          {{/if}}
        </div>
      {{/each}}
    {{else}}
      <div class="admin-form-card"><div class="empty-state">No polls yet. Run <code>/poll create question:"..."</code> in Discord to start one.</div></div>
    {{/if}}
  </div>
  {{/if}}

