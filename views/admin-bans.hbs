<section id="admin-section">
  {{> admin-nav}}

  {{#if successMessage}}
    <div class="notice success-notice">
      <strong>Success</strong>
      <p>{{successMessage}}</p>
    </div>
  {{/if}}

  {{#if errorMessage}}
    <div class="error">{{errorMessage}}</div>
  {{/if}}

  <form class="filter-bar" method="GET" action="/admin/bans" id="ban-filter-form">
    <input
      type="text"
      name="search"
      class="filter-input"
      placeholder="Search bans..."
      value="{{search}}"
    >
    <select name="field" class="filter-select">
      <option value="all" {{#if (eq field 'all')}}selected{{/if}}>All Fields</option>
      <option value="username" {{#if (eq field 'username')}}selected{{/if}}>Username</option>
      <option value="guid" {{#if (eq field 'guid')}}selected{{/if}}>Arma GUID</option>
      <option value="banned_by" {{#if (eq field 'banned_by')}}selected{{/if}}>Banned By</option>
      <option value="reason" {{#if (eq field 'reason')}}selected{{/if}}>Reason</option>
    </select>
    <select name="range" id="ban-range-select" class="filter-select">
      <option value="all" {{#if (eq dateRange 'all')}}selected{{/if}}>Any Date</option>
      <option value="24h" {{#if (eq dateRange '24h')}}selected{{/if}}>Last 24 hours</option>
      <option value="7d" {{#if (eq dateRange '7d')}}selected{{/if}}>Last 7 days</option>
      <option value="30d" {{#if (eq dateRange '30d')}}selected{{/if}}>Last 30 days</option>
      <option value="90d" {{#if (eq dateRange '90d')}}selected{{/if}}>Last 90 days</option>
      <option value="custom" {{#if (eq dateRange 'custom')}}selected{{/if}}>Custom Range…</option>
    </select>
    <input type="date" name="from" id="ban-date-from" class="filter-input" value="{{dateFrom}}" style="display:{{#if (eq dateRange 'custom')}}inline-block{{else}}none{{/if}};max-width:150px;" title="From date">
    <input type="date" name="to" id="ban-date-to" class="filter-input" value="{{dateTo}}" style="display:{{#if (eq dateRange 'custom')}}inline-block{{else}}none{{/if}};max-width:150px;" title="To date">
    <div class="filter-actions">
      <button type="submit" class="btn btn-admin">Search</button>
      <a href="/admin/bans/export" class="btn btn-admin btn-export">Export CSV</a>
    </div>
  </form>
  <script>
  (function() {
    var sel = document.getElementById('ban-range-select');
    var from = document.getElementById('ban-date-from');
    var to = document.getElementById('ban-date-to');
    if (!sel) return;
    sel.addEventListener('change', function() {
      var show = this.value === 'custom';
      from.style.display = show ? 'inline-block' : 'none';
      to.style.display = show ? 'inline-block' : 'none';
      if (!show) { from.value = ''; to.value = ''; }
    });
  })();
  </script>

  {{#if bansError}}
    <div class="error">Failed to load ban list. Please try again.</div>
  {{else}}
    <p class="result-count">{{banCount}} ban{{#unless (eq banCount 1)}}s{{/unless}} found</p>

    {{#if bans.length}}
      <div class="ban-accordion">
        {{#each bans}}
          <div class="ban-item {{#if (eq this.duration_hours -1)}}ban-border-red{{else}}ban-border-yellow{{/if}}">
            <div class="ban-item-header">
              <div class="ban-item-summary">
                <span class="ban-item-id">#{{this.id}}</span>
                {{#if this.user_id_banned}}
                  <a href="/admin/player/{{this.user_id_banned}}" class="ban-item-name ban-player-link" onclick="event.stopPropagation();">{{fallback this.banned_arma_username "Unknown"}}</a>
                {{else}}
                  <span class="ban-item-name">{{fallback this.banned_arma_username "Unknown"}}</span>
                {{/if}}
                {{#if (eq this.duration_hours -1)}}
                  <span class="badge badge-danger">PERMANENT</span>
                {{else}}
                  <span class="badge badge-warning">{{this.duration_hours}}h</span>
                {{/if}}
              </div>
              <div class="ban-item-right">
                <span style="color:var(--text-secondary);font-size:0.75rem;">{{fallback this.admin_name "-"}}</span>
                <span style="color:var(--text-secondary);font-size:0.7rem;opacity:0.7;">{{formatDate this.time_stamp}}</span>
                <span class="ban-arrow">&#9662;</span>
              </div>
            </div>
            <div class="ban-item-body">
              <div class="ban-detail-grid">
                <div class="ban-detail">
                  <span class="ban-detail-label">Discord</span>
                  <span>{{fallback this.banned_discord_username "-"}}</span>
                </div>
                <div class="ban-detail">
                  <span class="ban-detail-label">Arma GUID</span>
                  <code style="font-size:0.8rem;">{{fallback this.user_id_banned "-"}}</code>
                </div>
                <div class="ban-detail">
                  <span class="ban-detail-label">Ban Date</span>
                  <span>{{formatDate this.time_stamp}}</span>
                </div>
                <div class="ban-detail">
                  <span class="ban-detail-label">Banned By</span>
                  <span>{{fallback this.admin_name "-"}}</span>
                </div>
                <div class="ban-detail">
                  <span class="ban-detail-label">Duration</span>
                  <span>{{#if (eq this.duration_hours -1)}}Permanent{{else}}{{this.duration_hours}}h{{/if}}</span>
                </div>
                <div class="ban-detail" style="grid-column: 1 / -1;">
                  <span class="ban-detail-label">Reason</span>
                  <span>{{fallback this.reason "-"}}</span>
                </div>
              </div>
              <div style="display:flex;gap:0.5rem;margin-top:0.75rem;flex-wrap:wrap;">
                {{#if this.user_id_banned}}
                  <a href="/admin/player/{{this.user_id_banned}}" class="btn btn-admin btn-small" style="text-decoration:none;background:#5865F2;color:#fff;">View Profile</a>
                {{/if}}
                <button class="btn btn-admin btn-small ban-notes-btn" data-arma-id="{{this.user_id_banned}}">Notes</button>
                <form method="POST" action="/admin/bans/unban" style="display:inline;" onsubmit="return confirm('Unban this player?');">
                  <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
                  <input type="hidden" name="ban_id" value="{{this.id}}">
                  <button type="submit" class="btn btn-admin btn-small" style="background:#22c55e;color:#fff;">Unban #{{this.id}}</button>
                </form>
              </div>
              <div class="ban-notes-editor" data-arma-id="{{this.user_id_banned}}" style="display:none;margin-top:0.75rem;">
                <textarea class="ban-notes-textarea" rows="3" placeholder="Add notes about this player..." style="width:100%;"></textarea>
                <div class="ban-notes-actions" style="display:flex;gap:0.5rem;align-items:center;margin-top:0.5rem;">
                  <button class="btn btn-admin btn-small ban-notes-save" data-arma-id="{{this.user_id_banned}}">Save</button>
                  <span class="ban-notes-status"></span>
                </div>
              </div>
            </div>
          </div>
        {{/each}}
      </div>
    {{else}}
      <div class="empty-state">No bans match your search.</div>
    {{/if}}
  {{/if}}

</section>

{{> ban-modal}}

<style>
.ban-accordion { display: flex; flex-direction: column; gap: 0.5rem; }
.ban-item { border: 1px solid var(--border); border-radius: 6px; background: var(--bg-card); overflow: hidden; }
.ban-border-red { border-left: 3px solid #ef4444; }
.ban-border-yellow { border-left: 3px solid #f59e0b; }
.ban-item-header { display: flex; justify-content: space-between; align-items: center; padding: 0.65rem 0.85rem; cursor: pointer; transition: background 0.12s; gap: 0.75rem; }
.ban-item-header:hover { background: var(--bg-primary); }
.ban-item-summary { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; min-width: 0; }
.ban-item-id { font-family: monospace; font-size: 0.8rem; color: var(--text-secondary); }
.ban-item-name { font-weight: 600; font-size: 0.9rem; color: var(--text-primary); }
.ban-player-link { text-decoration: none; color: var(--accent) !important; }
.ban-player-link:hover { text-decoration: underline; }
.ban-item-right { display: flex; align-items: center; gap: 0.75rem; flex-shrink: 0; }
.ban-arrow { font-size: 0.75rem; color: var(--text-secondary); transition: transform 0.2s; }
.ban-item.open .ban-arrow { transform: rotate(180deg); }
.ban-item-body { display: none; padding: 0 0.85rem 0.85rem; border-top: 1px solid var(--border); }
.ban-item.open .ban-item-body { display: block; }
.ban-detail-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.5rem; margin-top: 0.65rem; }
.ban-detail { display: flex; flex-direction: column; gap: 0.15rem; }
.ban-detail-label { font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.04em; }
@media (max-width: 640px) {
  .ban-item-right span:not(.ban-arrow) { display: none; }
}
</style>

<script>
(function() {
  var csrfToken = '{{csrfToken}}';
  var loadedNotes = {};

  // Accordion toggle — ignore clicks on inner buttons/links/forms
  document.querySelectorAll('.ban-item-header').forEach(function(header) {
    header.addEventListener('click', function(e) {
      if (e.target.closest('button') || e.target.closest('a') || e.target.closest('form')) return;
      header.closest('.ban-item').classList.toggle('open');
    });
  });

  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.ban-notes-btn');
    if (!btn) return;

    var armaId = btn.getAttribute('data-arma-id');
    if (!armaId) return;

    var editorDiv = btn.closest('.ban-item-body').querySelector('.ban-notes-editor[data-arma-id="' + armaId + '"]');
    if (editorDiv) {
      var isVisible = editorDiv.style.display !== 'none';
      editorDiv.style.display = isVisible ? 'none' : 'block';
      if (!isVisible && !loadedNotes[armaId]) {
        fetchNotes(armaId, editorDiv.querySelector('.ban-notes-textarea'));
      }
    }
  });

  function fetchNotes(armaId, textarea) {
    if (!textarea) return;
    textarea.value = 'Loading...';
    textarea.disabled = true;

    fetch('/admin/bans/notes?arma_id=' + encodeURIComponent(armaId))
      .then(function(r) { return r.json(); })
      .then(function(data) {
        textarea.value = data.web_notes || '';
        textarea.disabled = false;
        loadedNotes[armaId] = true;
      })
      .catch(function() {
        textarea.value = '';
        textarea.disabled = false;
      });
  }

  document.addEventListener('click', function(e) {
    var saveBtn = e.target.closest('.ban-notes-save');
    if (!saveBtn) return;

    var armaId = saveBtn.getAttribute('data-arma-id');
    var container = saveBtn.closest('.ban-notes-editor');
    var textarea = container.querySelector('.ban-notes-textarea');
    var status = container.querySelector('.ban-notes-status');

    saveBtn.disabled = true;
    status.textContent = 'Saving...';
    status.style.color = 'var(--text-secondary)';

    fetch('/admin/bans/notes', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken
      },
      body: JSON.stringify({ arma_id: armaId, web_notes: textarea.value })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      saveBtn.disabled = false;
      if (data.success) {
        status.textContent = 'Saved!';
        status.style.color = '#22c55e';
      } else {
        status.textContent = data.error || 'Error';
        status.style.color = 'var(--danger)';
      }
      setTimeout(function() { status.textContent = ''; }, 3000);
    })
    .catch(function() {
      saveBtn.disabled = false;
      status.textContent = 'Failed to save';
      status.style.color = 'var(--danger)';
      setTimeout(function() { status.textContent = ''; }, 3000);
    });
  });
})();
</script>
