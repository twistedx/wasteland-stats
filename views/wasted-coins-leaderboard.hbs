<section class="wc-lb-page" style="max-width:900px;margin:2rem auto 4rem;padding:0 1rem;">
  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:1.5rem;">
    <div>
      <h1 style="margin:0;font-family:'Orbitron',sans-serif;">All-Time Earners</h1>
      <p style="margin:0.25rem 0 0;color:var(--text-secondary);font-size:0.9rem;">Top 100 players by total {{coinEmoji}} {{coinName}} earned. Earnings count even after they're spent.</p>
    </div>
    <a href="/wasted-coins" class="btn btn-admin btn-small" style="text-decoration:none;">About Wasted Coins</a>
  </div>

  {{#if myRank}}
    <div class="wc-lb-mybanner">You're ranked <strong>#{{myRank}}</strong> on the all-time list. Keep grinding.</div>
  {{/if}}

  {{#if top.length}}
    <div class="wc-lb-podium">
      {{#each top}}
        {{#if (lt @index 3)}}
          <div class="wc-lb-podium-card wc-lb-rank-{{add @index 1}}{{#if (eq this.discord_id @root.myDiscordId)}} wc-lb-me{{/if}}">
            <div class="wc-lb-podium-rank">{{#if (eq @index 0)}}🥇{{else}}{{#if (eq @index 1)}}🥈{{else}}🥉{{/if}}{{/if}}</div>
            <div class="wc-lb-podium-name">{{this.username}}</div>
            <div class="wc-lb-podium-amount">{{@root.coinEmoji}} {{formatNumber this.total_earned}}</div>
            <div class="wc-lb-podium-sub">earned all-time</div>
          </div>
        {{/if}}
      {{/each}}
    </div>

    <div class="admin-form-card">
      <div class="table-scroll">
      <table class="wc-lb-table">
        <thead><tr><th>Rank</th><th>Player</th><th class="r">Earned</th><th class="r">Balance</th><th class="r">Spent</th></tr></thead>
        <tbody>
          {{#each top}}
            <tr class="{{#if (eq this.discord_id @root.myDiscordId)}}wc-lb-me-row{{/if}}">
              <td class="wc-lb-rank-cell">{{add @index 1}}</td>
              <td class="player-name">{{this.username}}</td>
              <td class="r"><strong>{{formatNumber this.total_earned}}</strong> {{@root.coinEmoji}}</td>
              <td class="r" style="color:#fde047;">{{formatNumber this.balance}}</td>
              <td class="r" style="color:var(--text-secondary);">{{formatNumber this.total_spent}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
      </div>
    </div>
  {{else}}
    <div class="empty-state">Nobody has earned coins yet. Be the first — run <code>/daily</code> in Discord!</div>
  {{/if}}
</section>

<style>
.wc-lb-mybanner { background: linear-gradient(135deg, rgba(34,197,94,0.15), transparent); border: 1px solid rgba(34,197,94,0.4); border-radius: 8px; padding: 0.85rem 1.1rem; margin-bottom: 1.25rem; color: #4ade80; }
.wc-lb-podium { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
.wc-lb-podium-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px; padding: 1.25rem; text-align: center; }
.wc-lb-rank-1 { border-top: 4px solid #fbbf24; box-shadow: 0 0 24px rgba(251,191,36,0.15); }
.wc-lb-rank-2 { border-top: 4px solid #cbd5e1; }
.wc-lb-rank-3 { border-top: 4px solid #d97706; }
.wc-lb-me { outline: 2px solid #22c55e; outline-offset: -2px; }
.wc-lb-podium-rank { font-size: 2rem; line-height: 1; margin-bottom: 0.4rem; }
.wc-lb-podium-name { font-weight: 700; color: var(--text-primary); margin-bottom: 0.4rem; word-break: break-word; }
.wc-lb-podium-amount { font-size: 1.3rem; color: #fde047; font-weight: 700; }
.wc-lb-podium-sub { font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.25rem; }
.wc-lb-table { width: 100%; border-collapse: collapse; }
.wc-lb-table th { padding: 0.65rem 0.85rem; text-align: left; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); border-bottom: 1px solid var(--border); }
.wc-lb-table td { padding: 0.6rem 0.85rem; border-bottom: 1px solid var(--border); }
.wc-lb-table th.r, .wc-lb-table td.r { text-align: right; }
.wc-lb-rank-cell { font-family: monospace; color: var(--text-secondary); width: 60px; }
.wc-lb-me-row { background: rgba(34,197,94,0.08); }
.wc-lb-me-row .wc-lb-rank-cell { color: #22c55e; font-weight: 700; }
</style>
