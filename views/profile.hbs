<section class="profile-page {{#if donorTier}}profile-tier-{{donorTier}}{{/if}} {{#if isKing}}profile-king{{/if}} {{#if isGoat}}profile-goat{{/if}}">
  {{#if isGoat}}
  <div class="goat-bg" aria-hidden="true">
    <div class="goat-symbol">&#x1F410;</div>
  </div>
  {{/if}}
  {{#if isKing}}
  <div class="king-crown-bg" aria-hidden="true">
    <div class="king-crown-symbol">&#9812;</div>
  </div>
  {{/if}}
  {{#if donorTier}}
  <div class="profile-tier-watermarks" aria-hidden="true">
    <span>{{#if (eq donorTier 'legendary')}}&#9733;{{else if (eq donorTier 'diamond')}}&#9830;{{else if (eq donorTier 'platinum')}}&#9827;{{else if (eq donorTier 'gold')}}&#9829;{{else if (eq donorTier 'silver')}}&#9826;{{else}}&#9679;{{/if}}</span>
    <span>{{#if (eq donorTier 'legendary')}}&#9733;{{else if (eq donorTier 'diamond')}}&#9830;{{else if (eq donorTier 'platinum')}}&#9827;{{else if (eq donorTier 'gold')}}&#9829;{{else if (eq donorTier 'silver')}}&#9826;{{else}}&#9679;{{/if}}</span>
    <span>{{#if (eq donorTier 'legendary')}}&#9733;{{else if (eq donorTier 'diamond')}}&#9830;{{else if (eq donorTier 'platinum')}}&#9827;{{else if (eq donorTier 'gold')}}&#9829;{{else if (eq donorTier 'silver')}}&#9826;{{else}}&#9679;{{/if}}</span>
    <span>{{#if (eq donorTier 'legendary')}}&#9733;{{else if (eq donorTier 'diamond')}}&#9830;{{else if (eq donorTier 'platinum')}}&#9827;{{else if (eq donorTier 'gold')}}&#9829;{{else if (eq donorTier 'silver')}}&#9826;{{else}}&#9679;{{/if}}</span>
    <span>{{#if (eq donorTier 'legendary')}}&#9733;{{else if (eq donorTier 'diamond')}}&#9830;{{else if (eq donorTier 'platinum')}}&#9827;{{else if (eq donorTier 'gold')}}&#9829;{{else if (eq donorTier 'silver')}}&#9826;{{else}}&#9679;{{/if}}</span>
    <span>{{#if (eq donorTier 'legendary')}}&#9733;{{else if (eq donorTier 'diamond')}}&#9830;{{else if (eq donorTier 'platinum')}}&#9827;{{else if (eq donorTier 'gold')}}&#9829;{{else if (eq donorTier 'silver')}}&#9826;{{else}}&#9679;{{/if}}</span>
  </div>
  {{/if}}

  <!-- Hero Banner -->
  <div class="profile-hero {{#if donorTier}}hero-tier-{{donorTier}}{{/if}}">
    <div class="profile-hero-bg"></div>
    {{#if donorTier}}
      <div class="profile-hero-tier-img"></div>
    {{/if}}
    <div class="profile-hero-content">
      <div class="profile-hero-left">
        <div class="profile-avatar-wrap">
          <img src="{{user.avatarUrl}}" alt="avatar" class="profile-avatar">
          {{#if donorTier}}
            <span class="profile-donor-ring donor-{{donorTier}}"></span>
          {{/if}}
        </div>
        <div class="profile-hero-info">
          <h1 class="profile-username">{{user.username}}</h1>
        {{#if isKing}}<p class="profile-king-subtext">It's good to be King</p>{{/if}}
        {{#if isGoat}}<p class="profile-goat-subtext">Greatest of All Time</p>{{/if}}
          <div class="profile-meta-row">
            {{#if stats}}<span class="profile-tag">{{stats.arma_username}}</span>{{/if}}
            {{#if steamId}}
              <a href="https://steamcommunity.com/profiles/{{steamId}}" target="_blank" rel="noopener" class="profile-steam-btn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3l-.5 3H13v6.95c5.05-.5 9-4.76 9-9.95 0-5.52-4.48-10-10-10z"/></svg>
                Steam
              </a>
            {{/if}}
            {{#if memberSince}}
              <span class="profile-tag" style="color:#5865F2;">Member for {{memberDays}} days</span>
            {{/if}}
          </div>
          <div class="profile-badges-row">
            {{#if isKing}}
            <div class="profile-king-badge">
              <span>👑</span>
              <span>King of the Wasteland</span>
            </div>
            {{/if}}
            {{#if isGoat}}
            <div class="profile-goat-badge">
              <span>🐐</span>
              <span>The G.O.A.T.</span>
            </div>
            {{/if}}
            {{#if leaderboardRank}}
            <div class="profile-rank-badge">
              <span class="profile-rank-number">#{{leaderboardRank}}</span>
              <span class="profile-rank-label">Leaderboard</span>
            </div>
            {{/if}}
          </div>
        </div>
      </div>
      {{#if (or donorTier activeTierName)}}
      <div class="profile-hero-right">
        {{#if donorTier}}
        <div class="profile-tier-showcase donor-showcase-{{donorTier}}">
          <div class="profile-tier-icon">{{#if (eq donorTier 'legendary')}}&#9733;{{else if (eq donorTier 'diamond')}}&#9830;{{else if (eq donorTier 'platinum')}}&#9827;{{else if (eq donorTier 'gold')}}&#9829;{{else if (eq donorTier 'silver')}}&#9826;{{else}}&#9679;{{/if}}</div>
          <div class="profile-tier-title">{{donorTier}}</div>
          <div class="profile-tier-subtitle">Supporter</div>
        </div>
        {{/if}}
        {{#if activeTierName}}
        <div class="profile-sub-showcase">
          <div class="profile-sub-showcase-icon">&#9889;</div>
          <div class="profile-sub-showcase-name">{{activeTierName}}</div>
          {{#if activeTier}}
          <div class="profile-sub-showcase-perks">
            <span>${{formatNumber activeTier.bankLimit}} bank</span>
            {{#if activeTier.skinsPerMonth}}<span>{{activeTier.skinsPerMonth}} skins/mo</span>{{/if}}
          </div>
          {{/if}}
        </div>
        {{/if}}
      </div>
      {{/if}}
    </div>
  </div>

  {{#if statsNotLinked}}
    <div class="notice" style="margin-top:1.5rem;">
      <strong>Account Not Linked</strong>
      <p>Your Discord account isn't linked to an Arma account yet. Use <code>/verify</code> in Discord or link your accounts in-game to see your stats here.</p>
    </div>
  {{else if statsError}}
    <div class="error" style="margin-top:1.5rem;">{{statsError}}</div>
  {{else if stats}}

    <!-- Season Toggle -->
    <div class="profile-toggle-bar">
      <a href="/profile?stats=season" class="stats-toggle-btn {{#if (eq statsTab 'season')}}active{{/if}}" onclick="showSpinner('Loading stats...')">Current Season</a>
      <a href="/profile?stats=alltime" class="stats-toggle-btn {{#if (eq statsTab 'alltime')}}active{{/if}}" onclick="showSpinner('Loading stats...')">All Time</a>
    </div>

    <!-- Primary Stats -->
    <div class="profile-stats-hero">
      <div class="profile-big-stat">
        <span class="profile-big-value kills-glow">{{formatNumber stats.kill_count}}</span>
        <span class="profile-big-label">Kills</span>
      </div>
      <div class="profile-big-stat">
        <span class="profile-big-value">{{formatNumber stats.deaths}}</span>
        <span class="profile-big-label">Deaths</span>
      </div>
      <div class="profile-big-stat">
        <span class="profile-big-value kd-glow">{{fallback stats.kdRatio "0.0"}}</span>
        <span class="profile-big-label">K/D Ratio</span>
      </div>
    </div>

    <!-- Support CTA for non-supporters -->
    {{#if ctaMessage}}
    <div class="profile-cta-banner">
      <div class="profile-cta-glow"></div>
      <div class="profile-cta-content">
        <h3 class="profile-cta-headline">{{ctaMessage.headline}}</h3>
        <p class="profile-cta-sub">{{ctaMessage.sub}}</p>
        <a href="/store" class="btn btn-donate profile-cta-btn" data-cta-index="{{ctaIndex}}" data-cta-text="{{ctaMessage.headline}}">Support the Project</a>
      </div>
    </div>
    {{/if}}

    <!-- Combat Details -->
    <div class="profile-grid">

      <!-- Rivals -->
      <div class="profile-card">
        <div class="profile-card-header">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="color:#ef4444;"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
          Rivals
        </div>
        <div class="profile-card-body">
          {{#if hasMostKilled}}
          <div class="profile-rival">
            <span class="profile-rival-label">Favorite Target</span>
            <span class="profile-rival-name">{{stats.mostKilled}}</span>
            <span class="profile-rival-count">{{stats.mostKilledCount}}x</span>
          </div>
          {{/if}}
          {{#if hasMostKilledBy}}
          <div class="profile-rival">
            <span class="profile-rival-label">Nemesis</span>
            <span class="profile-rival-name" style="color:#ef4444;">{{stats.mostKilledBy}}</span>
            <span class="profile-rival-count">{{stats.mostKilledByCount}}x</span>
          </div>
          {{/if}}
          {{#unless hasMostKilled}}{{#unless hasMostKilledBy}}
            <div class="empty-state">No rival data yet.</div>
          {{/unless}}{{/unless}}
        </div>
      </div>

      <!-- Recent Kills -->
      <div class="profile-card">
        <div class="profile-card-header">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="color:#fbbf24;"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          Recent Kills
        </div>
        <div class="profile-card-body">
          {{#if recentKills.length}}
          <div class="profile-kills-list">
            {{#each recentKills}}
            <div class="profile-kill-row">
              <span class="profile-kill-victim">{{this.victim_username}}</span>
              <span class="profile-kill-weapon">{{fallback this.weapon "-"}}</span>
              <span class="profile-kill-dist">{{#if this.distance}}{{this.distance}}m{{/if}}</span>
            </div>
            {{/each}}
          </div>
          {{else}}
          <div class="empty-state">No recent kills recorded.</div>
          {{/if}}
        </div>
      </div>

      <!-- Economy -->
      <div class="profile-card profile-card-wide">
        <div class="profile-card-header" style="background:linear-gradient(90deg, rgba(34,197,94,0.08), transparent);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="color:#22c55e;"><path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/></svg>
          Economy
        </div>
        <div class="profile-card-body">
          <div class="profile-stats-grid">
            <div class="profile-stat-item">
              <span class="profile-stat-val cash-glow">{{#if atmBalance}}${{formatNumber atmBalance}}{{else}}<span style="font-size:0.8rem;color:var(--text-secondary);font-family:inherit;">Go earn some money!</span>{{/if}}</span>
              <span class="profile-stat-lbl">Cash Balance</span>
            </div>
            <div class="profile-stat-item">
              <span class="profile-stat-val" style="color:#fbbf24;">{{#if atmLimit}}${{formatNumber atmLimit}}{{else}}$150,000{{/if}}</span>
              <span class="profile-stat-lbl">ATM Limit</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Supporter Awards -->
      <div class="profile-card profile-card-wide profile-awards-card">
        <div class="profile-card-header" style="background:linear-gradient(90deg, rgba(245,158,11,0.08), transparent);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="color:#f59e0b;"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
          Supporter Awards
        </div>
        <div class="profile-card-body">
          {{#if purchaseCount}}
          <div class="profile-supporter-stats" style="margin-bottom:1.25rem;">
            <div class="profile-supporter-item">
              <span class="profile-supporter-value" style="color:#22c55e;">${{totalSpent}}</span>
              <span class="profile-supporter-label">Total Contributed</span>
            </div>
            <div class="profile-supporter-item">
              <span class="profile-supporter-value">{{purchaseCount}}</span>
              <span class="profile-supporter-label">Purchases</span>
            </div>
            {{#if activeTier}}
            <div class="profile-supporter-item">
              <span class="profile-supporter-value" style="color:#fbbf24;">${{formatNumber activeTier.bankLimit}}</span>
              <span class="profile-supporter-label">Bank Limit</span>
            </div>
            <div class="profile-supporter-item">
              <span class="profile-supporter-value" style="color:#a78bfa;">{{activeTier.skinsPerMonth}}</span>
              <span class="profile-supporter-label">Skins / Month</span>
            </div>
            {{/if}}
          </div>
          {{/if}}

          {{#if nextTier}}
          <div class="tier-progress-bar">
            <div class="tier-progress-info">
              <span>{{#if donorTier}}<span class="tier-current-label tier-color-{{donorTier}}">{{donorTier}}</span>{{else}}No Tier{{/if}}</span>
              <span class="tier-next-label">Next: <strong class="tier-color-{{nextTier.key}}">{{nextTier.label}}</strong></span>
            </div>
            <div class="tier-progress-track">
              <div class="tier-progress-fill tier-fill-{{donorTier}}" style="width:{{nextTierProgress}}%;"></div>
            </div>
            <div class="tier-progress-pct">{{nextTierProgress}}%</div>
          </div>
          {{/if}}

          <div class="tier-awards-grid">
            {{#each awards}}
            <div class="tier-award {{#if this.isCurrent}}tier-current{{else if this.unlocked}}tier-unlocked{{else}}tier-locked{{/if}} tier-card-{{this.key}}">
              {{#if this.isCurrent}}<div class="tier-current-banner">Current</div>{{/if}}
              <div class="tier-award-icon">{{{this.icon}}}</div>
              <div class="tier-award-label">{{this.label}}</div>
              {{#if this.unlocked}}
                <div class="tier-award-check">&#10003;</div>
              {{else}}
                <div class="tier-award-lock">&#128274;</div>
              {{/if}}
              <div class="tier-award-perks">
                {{#each this.perks}}<span>{{this}}</span>{{/each}}
              </div>
            </div>
            {{/each}}
          </div>
          <div style="text-align:center;margin-top:1.25rem;">
            <a href="/store" class="btn btn-donate profile-tier-btn" data-cta-index="tier-{{tierBtnIndex}}" data-cta-text="{{tierBtnText}}">{{tierBtnText}}</a>
          </div>
        </div>
      </div>

      <!-- Skins & Roles -->
      {{#if (or skinCount memberRoles.length)}}
      <div class="profile-half-row {{#unless memberRoles.length}}profile-half-single{{/unless}} {{#unless skinCount}}profile-half-single{{/unless}}">
        {{#if skinCount}}
        <div class="profile-card">
          <div class="profile-card-header" style="background:linear-gradient(90deg, rgba(167,139,250,0.08), transparent);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="color:#a78bfa;"><path d="M21 3H3c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H3V5h18v14zM5 15h14v3H5z"/></svg>
            Skin Collection ({{skinCount}})
          </div>
          <div class="profile-card-body">
            <div class="profile-skin-list">
              {{#each ownedSkins}}
              <div class="profile-skin-item {{#if this.rarity}}rarity-{{this.rarity}}{{/if}}">
                <span class="profile-skin-name">{{this.name}}</span>
                <span class="profile-skin-rarity">{{#if (gt this.quantity 1)}}x{{this.quantity}}{{/if}} {{#if this.rarity}}{{this.rarity}}{{/if}}</span>
              </div>
              {{/each}}
            </div>
          </div>
        </div>
        {{/if}}
        {{#if memberRoles.length}}
        <div class="profile-card roles-card-{{roleTier}}">
          <div class="profile-card-header roles-header-{{roleTier}}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="color:#5865F2;"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
            Discord Roles ({{roleCount}})
            <span class="roles-tier-badge roles-badge-{{roleTier}}">{{roleTier}}</span>
            <span class="roles-info-icon" title="Gain more Discord roles to grow your status">&#9432;</span>
          </div>
          <div class="profile-card-body">
            <div class="profile-roles-wrap">
              {{#each memberRoles}}
              <span class="profile-role-pill" style="border-color:{{this.color}};color:{{this.color}};">{{this.name}}</span>
              {{/each}}
            </div>
          </div>
        </div>
        {{/if}}
      </div>
      {{/if}}

      <!-- Purchase History -->
      {{#if purchasesFormatted.length}}
      <div class="profile-card profile-card-wide">
        <div class="profile-card-header">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="color:#22c55e;"><path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/></svg>
          Purchase History
        </div>
        <div class="profile-card-body">
          <div class="profile-purchase-list">
            {{#each purchasesFormatted}}
            <div class="profile-purchase-row">
              <span class="profile-purchase-name">{{this.product_name}}</span>
              <span class="profile-purchase-qty">{{#if (gt this.quantity 1)}}x{{this.quantity}}{{/if}}</span>
              <span class="profile-purchase-amount">${{this.amountDollars}}</span>
              <span class="profile-purchase-date">{{formatDate this.created_at}}</span>
            </div>
            {{/each}}
          </div>
        </div>
      </div>
      {{/if}}

      <!-- Detailed Stats -->
      {{#if miscStats.length}}
      <div class="profile-card profile-card-wide">
        <div class="profile-card-header">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="color:#4fc3f7;"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/></svg>
          Detailed Stats
        </div>
        <div class="profile-card-body">
          <div class="profile-detail-grid">
            {{#each miscStats}}
            <div class="profile-detail-item">
              <span class="profile-detail-value">{{formatNumber this.value}}</span>
              <span class="profile-detail-label">{{this.label}}</span>
            </div>
            {{/each}}
          </div>
        </div>
      </div>
      {{/if}}

    </div>

  {{else}}
    <div class="loading" style="margin-top:2rem;">Loading your profile...</div>
  {{/if}}

  <!-- Upsell / Completionist -->
  {{#if ownsAll}}
  <div class="profile-completionist">
    <div class="profile-completionist-glow"></div>
    <div class="profile-completionist-icon">&#9733;</div>
    <h3 class="profile-completionist-title">You Own Everything</h3>
    <p class="profile-completionist-text">You've collected every skin in the armory. You're a true Wasteland legend.</p>
  </div>
  {{else if upsellProducts.length}}
  <div class="profile-upsell">
    <div class="profile-upsell-header">
      <h3>Complete Your Collection</h3>
      <p>Skins you don't own yet — stand out on the battlefield.</p>
    </div>
    <div class="profile-upsell-grid">
      {{#each upsellProducts}}
      <div class="profile-upsell-card {{#if this.onSale}}profile-upsell-sale{{/if}}">
        {{#if this.onSale}}<div class="profile-upsell-sale-tag">SALE</div>{{/if}}
        {{#if this.image}}
        <div class="profile-upsell-img" style="background-image:url('{{this.image}}');"></div>
        {{else}}
        <div class="profile-upsell-img profile-upsell-img-placeholder"></div>
        {{/if}}
        <div class="profile-upsell-info">
          <span class="profile-upsell-name">{{this.name}}</span>
          {{#if this.badge}}<span class="profile-upsell-badge">{{this.badge}}</span>{{/if}}
          <div class="profile-upsell-price-row">
            {{#if this.originalPrice}}<span class="profile-upsell-original">${{this.originalPrice}}</span>{{/if}}
            <span class="profile-upsell-price">${{this.price}}</span>
          </div>
          <button class="btn btn-discord profile-upsell-buy" data-id="{{this.id}}" data-name="{{this.name}}" data-price="{{this.price}}" style="margin-top:0.5rem;font-size:0.75rem;padding:0.4rem 0.8rem;">Add to Cart</button>
        </div>
      </div>
      {{/each}}
    </div>
    <div class="profile-upsell-cta">
      <a href="/store" class="btn btn-donate">Browse the Skin Store</a>
    </div>
  </div>
  {{/if}}

  <!-- Floating cart icon -->
  <button id="profile-cart-icon" class="profile-cart-icon" style="display:none;" type="button">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/></svg>
    <span class="profile-cart-count">0</span>
  </button>

  <!-- Cart drawer -->
  <div id="profile-cart-drawer" class="profile-cart-drawer" role="dialog">
    <div class="profile-cart-drawer-header">
      <h3>Your Cart</h3>
      <button id="profile-cart-close" class="profile-cart-close" type="button">&times;</button>
    </div>
    <div id="profile-cart-items" class="profile-cart-items">
      <p class="cart-empty">Your cart is empty.</p>
    </div>
    <div id="profile-cart-footer" class="profile-cart-footer" style="display:none;">
      <div class="profile-cart-total">
        Total: <span id="profile-cart-total-amount">$0.00</span>
      </div>
      <form method="POST" action="/store/checkout">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <input type="hidden" name="cart" id="profile-cart-data" value="">
        <button type="submit" class="btn btn-checkout btn-large" style="width:100%;">Checkout with Stripe</button>
      </form>
      <button id="profile-cart-clear" class="btn btn-small" style="margin-top:0.5rem;width:100%;background:var(--text-secondary);" type="button">Clear Cart</button>
    </div>
  </div>
  <div id="profile-cart-overlay" class="profile-cart-overlay"></div>

</section>

<script>
(function() {
  var csrf = '{{csrfToken}}';
  function trackCta(el) {
    if (!el) return;
    el.addEventListener('click', function() {
      var idx = el.getAttribute('data-cta-index');
      var text = el.getAttribute('data-cta-text');
      fetch('/api/profile-cta', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrf },
        body: JSON.stringify({ ctaIndex: idx, ctaText: text })
      }).catch(function() {});
    });
  }
  trackCta(document.querySelector('.profile-cta-btn'));
  trackCta(document.querySelector('.profile-tier-btn'));

  // Cart system — mirrors store page logic
  var ALL_PRODUCTS = {{{allProductsJson}}};
  function getCart() {
    try { return JSON.parse(localStorage.getItem('iwpg_cart')) || []; } catch(e) { return []; }
  }
  function saveCart(cart) { localStorage.setItem('iwpg_cart', JSON.stringify(cart)); }

  function updateCartIcon() {
    var cart = getCart();
    var total = cart.reduce(function(s, i) { return s + (i.qty || 1); }, 0);
    var icon = document.getElementById('profile-cart-icon');
    if (!icon) return;
    var count = icon.querySelector('.profile-cart-count');
    if (total > 0) {
      icon.style.display = 'flex';
      count.textContent = total;
    } else {
      icon.style.display = 'none';
    }
  }

  function renderProfileCart() {
    var cart = getCart();
    var itemsEl = document.getElementById('profile-cart-items');
    var footerEl = document.getElementById('profile-cart-footer');
    var totalEl = document.getElementById('profile-cart-total-amount');
    var dataEl = document.getElementById('profile-cart-data');
    if (!itemsEl) return;

    updateCartIcon();

    if (cart.length === 0) {
      itemsEl.innerHTML = '<p class="cart-empty">Your cart is empty.</p>';
      footerEl.style.display = 'none';
      return;
    }

    var total = 0;
    itemsEl.innerHTML = cart.map(function(ci) {
      var cid = typeof ci.id === 'string' ? parseInt(ci.id) : ci.id;
      var p = ALL_PRODUCTS.find(function(pr) { return pr.id === cid; });
      if (!p) return '';
      var lineTotal = p.price * ci.qty;
      total += lineTotal;
      return '<div class="profile-cart-item">' +
        '<div style="display:flex;justify-content:space-between;align-items:center;">' +
          '<strong>' + p.name + '</strong>' +
          '<button class="profile-cart-remove" data-id="' + p.id + '" title="Remove">&times;</button>' +
        '</div>' +
        '<span style="font-size:0.75rem;color:var(--text-secondary);">$' + p.price.toFixed(2) + ' each</span>' +
        '<div style="display:flex;align-items:center;gap:0.5rem;margin-top:0.3rem;">' +
          '<button class="profile-qty-btn" data-id="' + p.id + '" data-delta="-1">&minus;</button>' +
          '<span>' + ci.qty + '</span>' +
          '<button class="profile-qty-btn" data-id="' + p.id + '" data-delta="1">+</button>' +
          '<span style="margin-left:auto;font-weight:700;color:#22c55e;">$' + lineTotal.toFixed(2) + '</span>' +
        '</div>' +
      '</div>';
    }).join('');

    totalEl.textContent = '$' + total.toFixed(2);
    footerEl.style.display = 'block';
    dataEl.value = JSON.stringify(cart);

    itemsEl.querySelectorAll('.profile-qty-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var id = Number(btn.getAttribute('data-id'));
        var delta = parseInt(btn.getAttribute('data-delta'));
        var c = getCart();
        var item = c.find(function(i) { return i.id === id; });
        if (!item) return;
        item.qty += delta;
        if (item.qty <= 0) { c = c.filter(function(i) { return i.id !== id; }); }
        saveCart(c);
        renderProfileCart();
      });
    });
    itemsEl.querySelectorAll('.profile-cart-remove').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var id = Number(btn.getAttribute('data-id'));
        saveCart(getCart().filter(function(i) { return i.id !== id; }));
        renderProfileCart();
      });
    });
  }

  function openProfileCart() {
    document.getElementById('profile-cart-drawer').classList.add('open');
    document.getElementById('profile-cart-overlay').classList.add('open');
    renderProfileCart();
  }
  function closeProfileCart() {
    document.getElementById('profile-cart-drawer').classList.remove('open');
    document.getElementById('profile-cart-overlay').classList.remove('open');
  }

  document.getElementById('profile-cart-icon').addEventListener('click', openProfileCart);
  document.getElementById('profile-cart-close').addEventListener('click', closeProfileCart);
  document.getElementById('profile-cart-overlay').addEventListener('click', closeProfileCart);
  document.getElementById('profile-cart-clear').addEventListener('click', function() {
    saveCart([]);
    renderProfileCart();
  });

  updateCartIcon();

  // Add to Cart from profile upsell
  document.querySelectorAll('.profile-upsell-buy').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var id = btn.getAttribute('data-id');
      var name = btn.getAttribute('data-name');
      var price = btn.getAttribute('data-price');

      // Add to store cart (shared localStorage with /store)
      var cart = getCart();
      var existing = cart.find(function(i) { return i.id == id; });
      if (existing) { existing.qty += 1; } else { cart.push({ id: Number(id), qty: 1 }); }
      saveCart(cart);

      // Track as profile purchase event
      fetch('/api/profile-cta', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrf },
        body: JSON.stringify({ ctaIndex: 'upsell-' + id, ctaText: 'Add to Cart: ' + name + ' ($' + price + ')' })
      }).catch(function() {});

      // Open drawer
      openProfileCart();
    });
  });
})();
</script>

