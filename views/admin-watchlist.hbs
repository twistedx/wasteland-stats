<section id="admin-section">
  {{> admin-nav}}

  {{#if successMessage}}
    <div class="notice success-notice">
      <strong>Success</strong>
      <p>{{successMessage}}</p>
    </div>
  {{/if}}

  {{#if errorMessage}}
    <div class="error">{{errorMessage}}</div>
  {{/if}}

  <h1 style="font-family:'Orbitron',sans-serif;font-size:1.1rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--accent);margin-bottom:1rem;">Add Someone to the Watchlist</h1>

  <form class="filter-bar" method="GET" action="/admin/watchlist">
    <input
      type="text"
      name="search"
      class="filter-input"
      placeholder="Search players by username..."
      value="{{search}}"
    >
    <div class="filter-actions">
      <button type="submit" class="btn btn-admin">Search</button>
    </div>
  </form>

  {{#if watchlistError}}
    <div class="error">Failed to search players. Please try again.</div>
  {{else if search}}
    <p class="result-count">{{playerCount}} player{{#unless (eq playerCount 1)}}s{{/unless}} found</p>

    {{#if players.length}}
      <!-- Desktop table -->
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>Username</th>
              <th>Arma ID</th>
              <th>VAC</th>
              <th>Status</th>
              <th>Web Notes</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {{#each players}}
              <tr>
                <td class="player-name">{{this.arma_username}}</td>
                <td><code>{{this.arma_id}}</code></td>
                <td>
                  {{#if this.vac}}
                    {{#if this.vac.vacBanned}}
                      <span class="badge badge-danger" title="{{this.vac.numberOfVACBans}} VAC ban(s), {{this.vac.daysSinceLastBan}} days ago">VAC BANNED</span>
                    {{else if this.vac.numberOfGameBans}}
                      <span class="badge badge-warning" title="{{this.vac.numberOfGameBans}} game ban(s)">GAME BAN</span>
                    {{else}}
                      <span class="badge badge-clean">Clean</span>
                    {{/if}}
                  {{else if this.steam_id}}
                    <span class="badge badge-neutral" title="Steam: {{this.steam_id}}">—</span>
                  {{else}}
                    <span style="color:var(--text-secondary);font-size:0.8rem;">No Steam</span>
                  {{/if}}
                </td>
                <td>
                  {{#if this.isWatchlisted}}
                    <span class="badge badge-danger">Watchlisted</span>
                  {{else}}
                    <span class="badge badge-neutral">Not Watched</span>
                  {{/if}}
                </td>
                <td class="web-notes-cell">
                  <form method="POST" action="/admin/watchlist/notes" class="notes-inline-form">
                    <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                    <input type="hidden" name="search" value="{{../search}}">
                    <input type="hidden" name="arma_id" value="{{this.arma_id}}">
                    <input type="text" name="web_notes" class="filter-input notes-input" value="{{this.webNotes}}" placeholder="Add notes...">
                    <button type="submit" class="btn btn-admin btn-small">Save</button>
                  </form>
                </td>
                <td>
                  {{#if this.isWatchlisted}}
                    <form method="POST" action="/admin/watchlist" style="display:inline;">
                      <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                      <input type="hidden" name="search" value="{{../search}}">
                      <input type="hidden" name="arma_id" value="{{this.arma_id}}">
                      <input type="hidden" name="action" value="remove">
                      <button type="submit" class="btn btn-admin btn-small" style="background:#22c55e;color:#fff;">Remove</button>
                    </form>
                  {{else}}
                    <form method="POST" action="/admin/watchlist" style="display:inline;">
                      <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                      <input type="hidden" name="search" value="{{../search}}">
                      <input type="hidden" name="arma_id" value="{{this.arma_id}}">
                      <input type="hidden" name="action" value="add">
                      <button type="submit" class="btn btn-admin btn-small" style="background:var(--danger);color:#fff;">Add to Watchlist</button>
                    </form>
                  {{/if}}
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

    {{else}}
      <p class="result-count" style="text-align:center;padding:2rem 0;color:var(--text-secondary);">No players found for "{{search}}"</p>
    {{/if}}
  {{else}}
    <p class="result-count" style="text-align:center;padding:2rem 0;color:var(--text-secondary);">Search for a player by username to view or update their watchlist status.</p>
  {{/if}}
</section>

{{> ban-modal}}

<style>
.badge-warning {
  background: rgba(245,158,11,0.2);
  color: #fbbf24;
  padding: 0.15rem 0.5rem;
  border-radius: 3px;
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.badge-clean {
  background: rgba(34,197,94,0.15);
  color: #4ade80;
  padding: 0.15rem 0.5rem;
  border-radius: 3px;
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
</style>
