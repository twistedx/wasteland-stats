<div class="hero" style="background-image: url('/img/image3.jpg');">
  <div class="hero-overlay">
    <h2 class="hero-title">Store</h2>
    <p class="hero-subtitle">Support the server — grab skins, items, and more.</p>
  </div>
</div>

<!-- Cart toggle button (fixed) -->
<button id="cart-toggle" class="cart-toggle" title="View Cart">
  <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/></svg>
  <span id="cart-count">0</span>
</button>

<!-- Cart drawer -->
<div id="cart-drawer" class="cart-drawer">
  <div class="cart-drawer-header">
    <h3>Your Cart</h3>
    <button id="cart-close" class="cart-close">&times;</button>
  </div>
  <div id="cart-items" class="cart-items">
    <p class="cart-empty">Your cart is empty.</p>
  </div>
  <div id="cart-footer" class="cart-footer" style="display:none;">
    <div class="cart-total">
      Total: <span id="cart-total-amount">$0.00</span>
    </div>
    <form id="checkout-form" method="POST" action="/build/checkout">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <input type="hidden" name="cart" id="cart-data" value="">
      <button type="submit" class="btn btn-checkout btn-large" style="width:100%;">Checkout with Stripe</button>
    </form>
    <button id="cart-clear" class="btn btn-small" style="margin-top:0.5rem;width:100%;background:var(--text-secondary);">Clear Cart</button>
  </div>
</div>
<div id="cart-overlay" class="cart-overlay"></div>

<section class="info-section store-section">
  <h2>Wasteland Loadout Skins</h2>
  <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">Browse items and add them to your cart. When you're ready, checkout securely via Stripe.</p>

  <div class="feature-grid store-grid" id="product-grid">
    <!-- Products are rendered from the data below -->
  </div>
</section>

<section class="info-section store-section">
  <h2>Support the Community</h2>
  <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">One-time supporter tiers — help keep the servers running and earn exclusive perks.</p>

  <div class="feature-grid store-grid" id="supporter-grid">
    <!-- Supporter tiers rendered by JS below -->
  </div>
</section>

<script>
(function() {
  // ── Product catalog ──
  const PRODUCTS = [
    { id: "loadout-sheen-out",    name: "The Sheen Out",    price: 19.99, image: "/img/store/charliesheen 1.png",  description: "Clean casual look with cargo shorts and a fresh white tee." },
    { id: "loadout-cowboy",       name: "The Cowboy",        price: 24.99, image: "/img/store/cowboy.png",           description: "Saddle up with a classic western hat and rugged denim." },
    { id: "loadout-lumberjack",   name: "The LumberJack",   price: 24.99, image: "/img/store/lumberjack 1.png",     description: "Flannel and denim — built for chopping wood and enemies." },
    { id: "loadout-corsair",      name: "The Corsair",       price: 29.99, image: "/img/store/pirate 1.png",         description: "Pirate-inspired loadout with a tricorn hat and leather boots." },
    { id: "loadout-burglar",      name: "The Burglar",       price: 29.99, image: "/img/store/burgler 1.png",        description: "Dark hoodie and tactical pants — move unseen in the shadows." },
    { id: "loadout-prepper",      name: "The Prepper",       price: 29.99, image: "/img/store/prepper 1.png",        description: "Survival-ready gear with a cap and earth-tone fatigues." },
    { id: "loadout-slav-specter", name: "The Slav Specter",  price: 29.99, image: "/img/store/theslav 1.png",        description: "Full camo loadout for blending into the wilderness." },
    { id: "loadout-packer",       name: "The Packer",        price: 29.99, image: "/img/store/thepacker 1.png",      description: "Green tactical jacket and cargo pants — ready for anything." },
  ];

  const SUPPORTER_TIERS = [
    { id: "supporter-wanderer",    name: "Wanderer",              price: 25.00,  image: "/img/store/wanderer.png",              description: "Start your journey — entry-level supporter tier with exclusive perks." },
    { id: "supporter-scout",       name: "Scout",                 price: 50.00,  image: "/img/store/scout.png",                 description: "Survival tier — elevated supporter status with bonus rewards." },
    { id: "supporter-ranger",      name: "Ranger",                price: 100.00, image: "/img/store/ranger.png",                description: "Elite tier — serious commitment with premium community benefits." },
    { id: "supporter-hero",        name: "Wasteland Hero",        price: 250.00, image: "/img/store/hero.png",        description: "Hero tier — top-level support with exclusive in-game recognition." },
    { id: "supporter-legendary",   name: "Legendary Wastelander", price: 475.00, image: "/img/store/legendary.png", description: "Ultimate supporter — the highest honor with all perks unlocked." },
    { id: "supporter-warlord",     name: "Warlord",               price: 650.00, image: "/img/store/warlord.png",               description: "Warlord tier — command respect with top-tier recognition and rewards." },
    { id: "supporter-overlord",    name: "Overlord",              price: 850.00, image: "/img/store/overlord.png",              description: "Overlord tier — dominate the wasteland with unmatched supporter status." },
    { id: "supporter-immortal",    name: "Immortal",              price: 1000.00, image: "/img/store/immortal.png",             description: "Immortal tier — the pinnacle of support. Your legacy lives forever." },
  ];

  // ── Cart state (localStorage) ──
  function getCart() {
    try { return JSON.parse(localStorage.getItem("iwpg_cart")) || []; }
    catch { return []; }
  }
  function saveCart(cart) {
    localStorage.setItem("iwpg_cart", JSON.stringify(cart));
  }

  function addToCart(productId) {
    const cart = getCart();
    const existing = cart.find(i => i.id === productId);
    if (existing) {
      existing.qty += 1;
    } else {
      cart.push({ id: productId, qty: 1 });
    }
    saveCart(cart);
    renderCart();
    openDrawer();
  }

  function removeFromCart(productId) {
    let cart = getCart().filter(i => i.id !== productId);
    saveCart(cart);
    renderCart();
  }

  function updateQty(productId, delta) {
    const cart = getCart();
    const item = cart.find(i => i.id === productId);
    if (!item) return;
    item.qty += delta;
    if (item.qty <= 0) return removeFromCart(productId);
    saveCart(cart);
    renderCart();
  }

  // ── Render ──
  function renderProducts() {
    const grid = document.getElementById("product-grid");
    grid.innerHTML = PRODUCTS.map(p => {
      const isLimited = p.name.includes("Leaving Soon");
      return `
      <div class="feature-card store-card has-image">
        <div class="store-image-wrap">
          ${p.image ? `<img src="${p.image}" alt="${p.name}" class="card-image">` : ""}
          <span class="store-badge new-badge">New</span>
          ${isLimited ? '<span class="store-badge limited">Limited Time</span>' : ""}
        </div>
        <div class="card-body">
          <h4>${p.name}</h4>
          <p>${p.description}</p>
          <p class="store-price"><strong>$${p.price.toFixed(2)}</strong></p>
          <button class="btn btn-discord btn-add-cart" data-id="${p.id}">Add to Cart</button>
        </div>
      </div>`;
    }).join("");

    grid.querySelectorAll(".btn-add-cart").forEach(btn => {
      btn.addEventListener("click", () => addToCart(btn.dataset.id));
    });

    // Render supporter tiers
    const supporterGrid = document.getElementById("supporter-grid");
    supporterGrid.innerHTML = SUPPORTER_TIERS.map(p => `
      <div class="feature-card store-card has-image">
        <div class="store-image-wrap">
          ${p.image ? `<img src="${p.image}" alt="${p.name}" class="card-image">` : ""}
        </div>
        <div class="card-body">
          <h4>${p.name}</h4>
          <p>${p.description}</p>
          <p class="store-price"><strong>$${p.price.toFixed(2)}</strong></p>
          <span style="font-size:0.75rem;color:var(--text-secondary);margin-bottom:0.5rem;display:block;">One-time payment</span>
          <button class="btn btn-discord btn-add-cart" data-id="${p.id}">Add to Cart</button>
        </div>
      </div>
    `).join("");

    supporterGrid.querySelectorAll(".btn-add-cart").forEach(btn => {
      btn.addEventListener("click", () => addToCart(btn.dataset.id));
    });
  }

  function renderCart() {
    const cart = getCart();
    const countEl = document.getElementById("cart-count");
    const itemsEl = document.getElementById("cart-items");
    const footerEl = document.getElementById("cart-footer");
    const totalEl = document.getElementById("cart-total-amount");
    const dataEl = document.getElementById("cart-data");

    const totalQty = cart.reduce((s, i) => s + i.qty, 0);
    countEl.textContent = totalQty;
    countEl.style.display = totalQty > 0 ? "flex" : "none";

    if (cart.length === 0) {
      itemsEl.innerHTML = '<p class="cart-empty">Your cart is empty.</p>';
      footerEl.style.display = "none";
      return;
    }

    let total = 0;
    itemsEl.innerHTML = cart.map(ci => {
      const p = PRODUCTS.find(pr => pr.id === ci.id) || SUPPORTER_TIERS.find(pr => pr.id === ci.id);
      if (!p) return "";
      const lineTotal = p.price * ci.qty;
      total += lineTotal;
      return `
        <div class="cart-item">
          <div class="cart-item-header">
            <strong>${p.name}</strong>
            <button class="cart-remove" data-id="${p.id}" title="Remove">&times;</button>
          </div>
          <span class="cart-item-price">$${p.price.toFixed(2)} each</span>
          <div class="cart-item-controls">
            <button class="qty-btn" data-id="${p.id}" data-delta="-1">&minus;</button>
            <span class="qty-value">${ci.qty}</span>
            <button class="qty-btn" data-id="${p.id}" data-delta="1">+</button>
          </div>
          <div class="cart-item-line">$${lineTotal.toFixed(2)}</div>
        </div>`;
    }).join("");

    totalEl.textContent = "$" + total.toFixed(2);
    footerEl.style.display = "block";
    dataEl.value = JSON.stringify(cart);

    itemsEl.querySelectorAll(".qty-btn").forEach(btn => {
      btn.addEventListener("click", () => updateQty(btn.dataset.id, parseInt(btn.dataset.delta)));
    });
    itemsEl.querySelectorAll(".cart-remove").forEach(btn => {
      btn.addEventListener("click", () => removeFromCart(btn.dataset.id));
    });
  }

  // ── Drawer open/close ──
  function openDrawer() {
    document.getElementById("cart-drawer").classList.add("open");
    document.getElementById("cart-overlay").classList.add("open");
  }
  function closeDrawer() {
    document.getElementById("cart-drawer").classList.remove("open");
    document.getElementById("cart-overlay").classList.remove("open");
  }

  document.getElementById("cart-toggle").addEventListener("click", openDrawer);
  document.getElementById("cart-close").addEventListener("click", closeDrawer);
  document.getElementById("cart-overlay").addEventListener("click", closeDrawer);
  document.getElementById("cart-clear").addEventListener("click", () => {
    saveCart([]);
    renderCart();
  });

  // Clear cart on successful checkout return
  if (new URLSearchParams(window.location.search).get("success") === "1") {
    saveCart([]);
  }

  renderProducts();
  renderCart();
})();
</script>

<style>
/* ── Cart toggle button ── */
.cart-toggle {
  position: fixed;
  bottom: 2rem;
  right: 2rem;
  z-index: 1000;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 50%;
  width: 56px;
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: var(--text-primary);
  box-shadow: 0 4px 20px rgba(0,0,0,0.5);
  transition: border-color 0.2s, transform 0.2s;
}
.cart-toggle:hover { border-color: var(--accent); transform: scale(1.05); }
#cart-count {
  position: absolute;
  top: -4px;
  right: -4px;
  background: #5865F2;
  color: #fff;
  font-size: 0.7rem;
  font-weight: 700;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  display: none;
  align-items: center;
  justify-content: center;
}

/* ── Cart drawer ── */
.cart-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.6);
  z-index: 1100;
}
.cart-overlay.open { display: block; }

.cart-drawer {
  position: fixed;
  top: 0;
  right: -400px;
  width: 380px;
  max-width: 90vw;
  height: 100vh;
  background: var(--bg-secondary);
  border-left: 1px solid var(--border);
  z-index: 1200;
  display: flex;
  flex-direction: column;
  transition: right 0.3s ease;
}
.cart-drawer.open { right: 0; }

.cart-drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.25rem;
  border-bottom: 1px solid var(--border);
}
.cart-drawer-header h3 {
  font-family: 'Orbitron', sans-serif;
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--accent);
}
.cart-close {
  background: none;
  border: none;
  color: var(--text-secondary);
  font-size: 1.5rem;
  cursor: pointer;
  line-height: 1;
}
.cart-close:hover { color: var(--text-primary); }

.cart-items {
  flex: 1;
  overflow-y: auto;
  padding: 1rem;
}
.cart-empty { color: var(--text-secondary); text-align: center; padding: 2rem 0; }

.cart-item {
  padding: 0.75rem 0;
  border-bottom: 1px solid var(--border);
}
.cart-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.cart-item-header strong {
  font-size: 0.9rem;
  color: var(--text-primary);
}
.cart-item-price {
  font-size: 0.8rem;
  color: var(--text-secondary);
}
.cart-item-controls {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-top: 0.5rem;
}
.qty-btn {
  background: var(--bg-card);
  border: 1px solid var(--border);
  color: var(--text-primary);
  width: 28px;
  height: 28px;
  border-radius: 2px;
  cursor: pointer;
  font-size: 1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color 0.2s;
}
.qty-btn:hover { border-color: var(--accent); }
.qty-value {
  font-weight: 700;
  min-width: 1.5rem;
  text-align: center;
}
.cart-remove {
  background: none;
  border: none;
  color: var(--danger);
  font-size: 1.2rem;
  cursor: pointer;
  margin-left: auto;
  line-height: 1;
}
.cart-item-line {
  text-align: right;
  font-weight: 700;
  color: #4fc3f7;
  margin-top: 0.25rem;
}

.cart-footer {
  padding: 1rem 1.25rem;
  border-top: 1px solid var(--border);
}
.cart-total {
  font-family: 'Orbitron', sans-serif;
  font-size: 1rem;
  text-align: right;
  margin-bottom: 1rem;
  color: var(--text-primary);
}
.cart-total span { color: #4fc3f7; }

.btn-checkout {
  background: #5865F2;
  box-shadow: 0 0 15px rgba(88, 101, 242, 0.3);
  text-align: center;
}
.btn-checkout:hover {
  background: #4752c4;
  box-shadow: 0 0 25px rgba(88, 101, 242, 0.5);
  transform: translateY(-1px);
}

/* ── Store product cards ── */
.store-section { max-width: 1200px; margin: 2rem auto; padding: 0 1rem; }
.store-grid { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
.store-card { display: flex; flex-direction: column; }
.store-card .card-body { display: flex; flex-direction: column; flex: 1; }
.store-card .card-body p { flex: 1; }
.store-image-wrap {
  position: relative;
  overflow: hidden;
  border-radius: 4px 4px 0 0;
}
.store-card .card-image {
  width: 100%;
  height: 360px;
  object-fit: contain;
  display: block;
  background: #0d0d0d;
}
.store-badge {
  position: absolute;
  top: 0.5rem;
  right: 0.5rem;
  padding: 0.2rem 0.6rem;
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border-radius: 2px;
}
.store-badge.new-badge {
  left: 0.5rem;
  right: auto;
  background: #5865F2;
  color: #fff;
  box-shadow: 0 0 10px rgba(88, 101, 242, 0.4);
}
.store-badge.limited {
  background: var(--danger);
  color: #fff;
  box-shadow: 0 0 10px rgba(255, 62, 62, 0.4);
}
.store-price {
  font-size: 1.3rem;
  color: #4fc3f7;
  font-weight: 700;
  margin: 0.75rem 0;
}
.btn-add-cart { align-self: flex-start; }

/* Success/cancel banners */
.store-banner {
  padding: 1rem;
  border-radius: 4px;
  margin-bottom: 1.5rem;
  text-align: center;
  font-weight: 600;
}
.store-banner.success { background: rgba(76, 175, 80, 0.15); border: 1px solid rgba(76, 175, 80, 0.3); color: #66bb6a; }
.store-banner.cancel { background: rgba(255, 62, 62, 0.1); border: 1px solid rgba(255, 62, 62, 0.2); color: var(--danger); }
</style>

{{#if (eq (lookup this "success") "1")}}
  <script>document.querySelector('.store-section').insertAdjacentHTML('afterbegin', '<div class="store-banner success">Payment successful! Your items are being delivered.</div>');</script>
{{/if}}
{{#if (eq (lookup this "canceled") "1")}}
  <script>document.querySelector('.store-section').insertAdjacentHTML('afterbegin', '<div class="store-banner cancel">Checkout was canceled. Your cart items are still saved.</div>');</script>
{{/if}}
