<section id="admin-section">
  {{> admin-nav}}

  {{#if successMessage}}
    <div class="notice success-notice">
      <strong>Success</strong>
      <p>{{successMessage}}</p>
    </div>
  {{/if}}

  {{#if errorMessage}}
    <div class="error">{{errorMessage}}</div>
  {{/if}}

  <div class="admin-form-card">
    <h3>Search Player</h3>
    <form class="filter-bar" method="GET" action="/admin/money">
      <input
        type="text"
        name="search"
        class="filter-input"
        placeholder="Search by username..."
        value="{{search}}"
      >
      <button type="submit" class="btn btn-admin">Search</button>
    </form>

    {{#if players.length}}
      <p class="result-count">{{players.length}} player{{#unless (eq players.length 1)}}s{{/unless}} found</p>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>Username</th>
              <th>Arma ID</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            {{#each players}}
              <tr>
                <td class="player-name">{{fallback this.arma_username "Unknown"}}</td>
                <td class="guid">{{fallback this.arma_id "-"}}</td>
                <td>
                  <button
                    type="button"
                    class="btn btn-admin btn-small select-player-btn"
                    data-arma-id="{{this.arma_id}}"
                    data-username="{{this.arma_username}}"
                  >Select</button>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      {{#if (or hasPrev hasMore)}}
      <div style="display:flex;justify-content:space-between;align-items:center;margin-top:0.75rem;">
        {{#if hasPrev}}
          <a href="/admin/money?search={{search}}&p={{subtract searchPage 1}}" class="btn btn-admin btn-small">&laquo; Previous</a>
        {{else}}
          <span></span>
        {{/if}}
        <span style="font-size:0.8rem;color:var(--text-secondary);">Page {{searchPage}}</span>
        {{#if hasMore}}
          <a href="/admin/money?search={{search}}&p={{add searchPage 1}}" class="btn btn-admin btn-small">Next &raquo;</a>
        {{else}}
          <span></span>
        {{/if}}
      </div>
      {{/if}}
    {{else if search}}
      <div class="empty-state">No players found matching "{{search}}".</div>
    {{/if}}
  </div>

  <div class="admin-form-card">
    <h3>Add Money</h3>
    <form method="POST" action="/admin/money" class="money-form">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <div class="form-group">
        <label class="form-label">Player Arma ID</label>
        <input
          type="text"
          name="arma_id"
          id="arma-id-input"
          class="filter-input"
          placeholder="Arma ID (select from search or paste)"
          value="{{selectedArmaId}}"
          required
        >
      </div>
      <div class="form-group">
        <label class="form-label">Selected Player</label>
        <input
          type="text"
          id="selected-username"
          class="filter-input"
          value="{{selectedUsername}}"
          disabled
          placeholder="Search and select a player above"
        >
      </div>
      <div class="form-group" id="balance-group" style="display:none;">
        <label class="form-label">Current Balance</label>
        <div id="balance-display" class="balance-display">—</div>
      </div>
      <div class="form-group">
        <label class="form-label">Amount ($)</label>
        <input
          type="number"
          name="amount"
          class="filter-input"
          placeholder="Enter amount"
          required
          min="1"
        >
      </div>
      <button type="submit" class="btn btn-admin">Add Money</button>
    </form>
  </div>

  <div class="admin-form-card">
    <h3>💀 Add Wasted Coins</h3>
    <p style="color:var(--text-secondary);font-size:0.85rem;margin-bottom:0.75rem;">Add or remove Wasted Coins for a player. Select a player above or paste an Arma ID. Use positive to add, negative to deduct.</p>
    <form method="POST" action="/admin/money/coins" class="money-form">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <div class="form-group">
        <label class="form-label">Player Arma ID</label>
        <input
          type="text"
          name="arma_id"
          id="coins-arma-id-input"
          class="filter-input"
          placeholder="Arma ID (select from search or paste)"
          value="{{selectedArmaId}}"
          required
        >
      </div>
      <div class="form-group">
        <label class="form-label">Coins Amount</label>
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
          <input
            type="number"
            name="amount"
            id="coins-amount-input"
            class="filter-input"
            placeholder="Amount (positive or negative)"
            required
            style="flex:1;"
          >
          <button type="button" class="btn btn-admin btn-small coins-preset" data-val="500">+500</button>
          <button type="button" class="btn btn-admin btn-small coins-preset" data-val="1000">+1K</button>
          <button type="button" class="btn btn-admin btn-small coins-preset" data-val="2500">+2.5K</button>
          <button type="button" class="btn btn-admin btn-small coins-preset" data-val="5000">+5K</button>
        </div>
      </div>
      <button type="submit" class="btn btn-admin" style="background:#a855f7;color:#fff;">Add Coins</button>
    </form>
  </div>

  <div class="admin-form-card">
    <h3>Set ATM Deposit Limit</h3>
    <form method="POST" action="/admin/money/atm-limit" class="money-form">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <div class="form-group">
        <label class="form-label">Player Arma ID</label>
        <input
          type="text"
          name="arma_id"
          id="atm-arma-id-input"
          class="filter-input"
          placeholder="Arma ID (select from search or paste)"
          value="{{selectedArmaId}}"
          required
        >
      </div>
      <div class="form-group" id="atm-current-group" style="display:none;">
        <label class="form-label">Current ATM Limit</label>
        <div id="atm-current-display" class="balance-display">—</div>
      </div>
      <div class="form-group">
        <label class="form-label">New ATM Limit ($)</label>
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
          <input
            type="number"
            name="atm_limit"
            id="atm-limit-input"
            class="filter-input"
            placeholder="Enter limit amount"
            required
            min="1"
            style="flex:1;"
          >
          <button type="button" class="btn btn-admin btn-small atm-preset" data-val="150000">150K</button>
          <button type="button" class="btn btn-admin btn-small atm-preset" data-val="300000">300K</button>
          <button type="button" class="btn btn-admin btn-small atm-preset" data-val="500000">500K</button>
          <button type="button" class="btn btn-admin btn-small atm-preset" data-val="750000">750K</button>
          <button type="button" class="btn btn-admin btn-small atm-preset" data-val="1000000">1M</button>
        </div>
      </div>
      <button type="submit" class="btn btn-admin" style="background:#fbbf24;color:#000;">Set ATM Limit</button>
    </form>
  </div>
</section>

{{> ban-modal}}

<script>
  (function() {
    var balanceGroup = document.getElementById('balance-group');
    var balanceDisplay = document.getElementById('balance-display');
    var atmCurrentGroup = document.getElementById('atm-current-group');
    var atmCurrentDisplay = document.getElementById('atm-current-display');

    function fetchBalance(armaId) {
      if (!armaId) {
        balanceGroup.style.display = 'none';
        return;
      }
      balanceGroup.style.display = '';
      balanceDisplay.textContent = 'Loading...';
      fetch('/admin/money/balance?arma_id=' + encodeURIComponent(armaId))
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.balance !== null && data.balance !== undefined) {
            balanceDisplay.textContent = '$' + Number(data.balance).toLocaleString();
          } else {
            balanceDisplay.textContent = 'Unable to fetch balance';
          }
        })
        .catch(function() {
          balanceDisplay.textContent = 'Error fetching balance';
        });
    }

    function fetchAtmLimit(armaId) {
      if (!armaId) {
        atmCurrentGroup.style.display = 'none';
        return;
      }
      atmCurrentGroup.style.display = '';
      atmCurrentDisplay.textContent = 'Loading...';
      fetch('/admin/money/atm-limit?arma_id=' + encodeURIComponent(armaId))
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.atm_limit !== null && data.atm_limit !== undefined) {
            atmCurrentDisplay.textContent = '$' + Number(data.atm_limit).toLocaleString();
          } else {
            atmCurrentDisplay.textContent = '$150,000 (default)';
          }
        })
        .catch(function() {
          atmCurrentDisplay.textContent = 'Error fetching limit';
        });
    }

    function selectPlayer(armaId, username) {
      document.getElementById('arma-id-input').value = armaId;
      document.getElementById('selected-username').value = username;
      document.getElementById('atm-arma-id-input').value = armaId;
      document.getElementById('coins-arma-id-input').value = armaId;
      fetchBalance(armaId);
      fetchAtmLimit(armaId);
    }

    document.querySelectorAll('.select-player-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        selectPlayer(this.dataset.armaId, this.dataset.username);
      });
    });

    // ATM preset buttons
    document.querySelectorAll('.atm-preset').forEach(function(btn) {
      btn.addEventListener('click', function() {
        document.getElementById('atm-limit-input').value = this.dataset.val;
      });
    });

    // Coins preset buttons
    document.querySelectorAll('.coins-preset').forEach(function(btn) {
      btn.addEventListener('click', function() {
        document.getElementById('coins-amount-input').value = this.dataset.val;
      });
    });

    // If a player is already selected (from query params), fetch both
    var existingId = document.getElementById('arma-id-input').value;
    if (existingId) {
      fetchBalance(existingId);
      fetchAtmLimit(existingId);
      document.getElementById('atm-arma-id-input').value = existingId;
      document.getElementById('coins-arma-id-input').value = existingId;
    }
  })();
</script>
