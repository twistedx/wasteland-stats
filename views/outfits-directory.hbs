<div class="outfits-hero">
  <div class="outfits-hero-bg"></div>
  <div class="outfits-hero-inner">
    <div class="outfits-hero-eyebrow">⚔️ Mercenary Crews of the Wasteland</div>
    <h1 class="outfits-hero-title">Outfits</h1>
    <p class="outfits-hero-sub">Hunt rival crews. Wage 48-hour wars. Loot their treasury.<br><strong class="outfits-hero-strong">Fight for the title of The Outfit.</strong></p>
    <div class="outfits-hero-actions">
      {{#if user}}
        {{#if myOutfit}}
          <a href="/outfits/{{myOutfit.outfit_id}}" class="outfits-hero-btn outfits-hero-btn-primary">🎩 [{{myOutfit.outfit_tag}}] My Outfit</a>
        {{else}}
          <a href="/outfits/create" class="outfits-hero-btn outfits-hero-btn-primary">⚔️ Build Your Crew (5,000 💀)</a>
          <a href="/wasted-coins" class="outfits-hero-btn outfits-hero-btn-gold">💀 Earn Wasted Coins</a>
        {{/if}}
      {{else}}
        <a href="/auth/discord" class="outfits-hero-btn outfits-hero-btn-primary">Sign in with Discord</a>
      {{/if}}
    </div>
  </div>
</div>

<section style="max-width:1000px;margin:2rem auto 4rem;padding:0 1rem;">
  {{#if error}}
    <div class="error" style="margin-bottom:1rem;">{{error}}</div>
  {{/if}}


  {{> outfit-rules}}

  {{#if activeWars.length}}
  <div class="admin-form-card" style="margin-bottom:1.5rem;border-left:3px solid #ef4444;">
    <h3 style="margin:0 0 0.75rem;display:flex;align-items:center;gap:0.5rem;">⚔️ Active Wars <span style="font-size:0.7em;color:var(--text-secondary);font-weight:400;">({{activeWars.length}})</span></h3>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Status</th>
            <th>Matchup</th>
            <th>Wager</th>
            <th>Score</th>
            <th>Declared</th>
            <th>Ends</th>
          </tr>
        </thead>
        <tbody>
          {{#each activeWars}}
            <tr>
              <td>
                {{#if (eq this.status 'pending')}}<span style="color:#fbbf24;font-weight:700;text-transform:uppercase;font-size:0.7rem;letter-spacing:0.05em;">⏳ Pending</span>
                {{else}}<span style="color:#ef4444;font-weight:700;text-transform:uppercase;font-size:0.7rem;letter-spacing:0.05em;">🔥 Active</span>{{/if}}
              </td>
              <td>
                <a href="/outfits/{{this.challenger_outfit_id}}" style="color:var(--accent);text-decoration:none;font-weight:600;">[{{this.challenger_tag}}]</a>
                <span style="color:var(--text-secondary);"> vs </span>
                <a href="/outfits/{{this.defender_outfit_id}}" style="color:var(--accent);text-decoration:none;font-weight:600;">[{{this.defender_tag}}]</a>
              </td>
              <td>{{#if this.wager}}💀 {{formatNumber this.wager}}{{else}}<span style="color:var(--text-muted);">—</span>{{/if}}</td>
              <td>{{#if this.challenger_score}}{{this.challenger_score}}–{{this.defender_score}}{{else}}<span style="color:var(--text-muted);">0–0</span>{{/if}}</td>
              <td><span class="history-ts" data-ts="{{this.declared_at}}">{{formatDate this.declared_at}}</span></td>
              <td>{{#if this.ends_at}}<span class="history-ts" data-ts="{{this.ends_at}}">{{formatDate this.ends_at}}</span>{{else}}<span style="color:var(--text-muted);">—</span>{{/if}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
  {{/if}}

  {{#if outfitList.length}}
    <div class="outfit-accordion">
      {{#each outfitList}}
        <div class="outfit-item" style="border-left:3px solid {{this.color}};">
          <div class="outfit-item-header">
            <div class="outfit-item-summary">
              <span class="outfit-item-tag" style="color:{{this.color}};">[{{this.tag}}]</span>
              <span class="outfit-item-name">{{this.name}}</span>
              <span class="outfit-item-meta">{{this.member_count}} members</span>
              <span class="outfit-item-meta">{{this.record.wins}}W / {{this.record.losses}}L / {{this.record.ties}}T</span>
              <span class="outfit-item-meta" style="color:#fde047;">💀 {{formatNumber this.treasury}}</span>
            </div>
            <div class="outfit-item-right">
              <a href="/outfits/{{this.id}}" class="btn btn-admin btn-small" style="text-decoration:none;background:#5865F2;color:#fff;font-size:0.65rem;padding:0.15rem 0.5rem;" onclick="event.stopPropagation();">View</a>
              <span class="outfit-arrow">&#9662;</span>
            </div>
          </div>
          <div class="outfit-item-body">
            <div class="table-scroll">
              <table>
                <thead><tr><th>Player</th><th>Role</th><th>Joined</th></tr></thead>
                <tbody>
                  {{#each this.members}}
                    <tr>
                      <td class="player-name">{{#if (eq this.role 'don')}}🎩 {{else if (eq this.role 'capo')}}🥃 {{else}}🔫 {{/if}}{{#if this.arma_username}}{{this.arma_username}}{{else if this.username}}{{this.username}}{{else}}<span style="color:var(--text-muted);">Unknown</span>{{/if}}</td>
                      <td>{{#if (eq this.role 'don')}}Don{{else if (eq this.role 'capo')}}Capo{{else}}Soldier{{/if}}</td>
                      <td>{{formatDate this.joined_at}}</td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
            {{#if this.motto}}<p style="margin:0.5rem 0 0;color:#fff;font-size:0.9rem;font-style:italic;">"{{this.motto}}"</p>{{/if}}
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <div class="empty-state">No outfits yet. <a href="/outfits/create" style="color:var(--accent);">Create the first one</a> and stake your claim.</div>
  {{/if}}
</section>

<style>
/* ── Hero ── */
.outfits-hero {
  position: relative;
  padding: 4rem 1.5rem 3.5rem;
  margin-bottom: 2rem;
  overflow: hidden;
  border-bottom: 1px solid var(--border);
}
.outfits-hero-bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse at 30% 0%, rgba(168,85,247,0.18), transparent 55%),
    radial-gradient(ellipse at 80% 100%, rgba(239,68,68,0.14), transparent 55%),
    radial-gradient(ellipse at 50% 50%, rgba(88,101,242,0.10), transparent 65%),
    linear-gradient(180deg, #0a0a0d 0%, #14141a 100%);
  pointer-events: none;
  z-index: 0;
}
.outfits-hero-bg::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image:
    repeating-linear-gradient(0deg, rgba(255,255,255,0.025) 0 1px, transparent 1px 4px);
  opacity: 0.4;
}
.outfits-hero-inner {
  position: relative;
  z-index: 1;
  max-width: 900px;
  margin: 0 auto;
  text-align: center;
}
.outfits-hero-eyebrow {
  font-family: 'Orbitron', sans-serif;
  font-size: 0.78rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #fde047;
  opacity: 0.85;
  margin-bottom: 0.75rem;
}
.outfits-hero-title {
  font-family: 'Orbitron', sans-serif;
  font-size: clamp(2.75rem, 7vw, 4.5rem);
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin: 0 0 0.6rem;
  background: linear-gradient(180deg, #fff 0%, #b5b5c8 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  text-shadow: 0 0 40px rgba(168,85,247,0.15);
  line-height: 1;
}
.outfits-hero-sub {
  margin: 0 auto 1.75rem;
  max-width: 620px;
  color: #e5e7eb;
  font-size: clamp(0.95rem, 2vw, 1.1rem);
  line-height: 1.55;
}
.outfits-hero-strong {
  color: #fde047;
  font-weight: 700;
  font-size: 1.05em;
}
.outfits-hero-actions {
  display: flex;
  gap: 0.75rem;
  justify-content: center;
  flex-wrap: wrap;
}
.outfits-hero-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.85rem 1.6rem;
  border-radius: 8px;
  font-family: 'Orbitron', sans-serif;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  font-size: 0.85rem;
  text-decoration: none;
  border: 1px solid transparent;
  transition: transform 0.15s, box-shadow 0.15s, background 0.15s;
  min-height: 48px;
}
.outfits-hero-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 18px rgba(0,0,0,0.4);
}
.outfits-hero-btn-primary {
  background: linear-gradient(135deg, #5865F2, #7c3aed);
  color: #fff;
}
.outfits-hero-btn-primary:hover {
  background: linear-gradient(135deg, #6873ff, #8d4cf0);
}
.outfits-hero-btn-gold {
  background: linear-gradient(135deg, #fde047, #f59e0b);
  color: #1a1a1a;
  border-color: rgba(0,0,0,0.2);
}

@media (max-width: 640px) {
  .outfits-hero { padding: 2.5rem 1rem 2rem; margin-bottom: 1.25rem; }
  .outfits-hero-eyebrow { font-size: 0.7rem; letter-spacing: 0.14em; }
  .outfits-hero-title { font-size: clamp(2rem, 9vw, 3rem); }
  .outfits-hero-sub { font-size: 0.95rem; margin-bottom: 1.25rem; }
  .outfits-hero-btn { width: 100%; justify-content: center; padding: 0.85rem 1rem; }
}

/* ── Outfit accordion ── */
.outfit-accordion { display: flex; flex-direction: column; gap: 0.5rem; }
.outfit-item { border: 1px solid var(--border); border-radius: 6px; background: var(--bg-card); overflow: hidden; }
.outfit-item-header { display: flex; justify-content: space-between; align-items: center; padding: 0.85rem 1rem; cursor: pointer; transition: background 0.12s; gap: 0.75rem; min-height: 48px; }
.outfit-item-header:hover { background: var(--bg-primary); }
.outfit-item-summary { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; min-width: 0; }
.outfit-item-tag { font-family: 'Orbitron', monospace; font-weight: 700; font-size: 1rem; }
.outfit-item-name { font-weight: 600; font-size: 0.95rem; color: #fff; }
.outfit-item-meta { font-size: 0.85rem; color: #fff; }
.outfit-item-right { display: flex; align-items: center; gap: 0.75rem; flex-shrink: 0; }
.outfit-arrow { font-size: 0.85rem; color: #fff; transition: transform 0.2s; }
.outfit-item.open .outfit-arrow { transform: rotate(180deg); }
.outfit-item-body { display: none; padding: 0 1rem 1rem; border-top: 1px solid var(--border); }
.outfit-item.open .outfit-item-body { display: block; }
.outfit-item-body table { color: #fff; }
.outfit-item-body th { color: #fff; }

@media (max-width: 640px) {
  section[style*="max-width:1000px"] { padding: 0 0.75rem !important; margin: 1rem auto 2rem !important; }
  .outfit-item-header { padding: 0.85rem 0.75rem; gap: 0.5rem; }
  .outfit-item-summary { gap: 0.4rem 0.6rem; }
  .outfit-item-tag { font-size: 0.95rem; }
  .outfit-item-name { font-size: 0.9rem; flex-basis: 100%; }
  .outfit-item-meta { font-size: 0.78rem; }
  .outfit-item-right .btn { padding: 0.4rem 0.75rem !important; font-size: 0.75rem !important; min-height: 40px; display: inline-flex; align-items: center; }
  .outfit-item-body { padding: 0 0.75rem 0.75rem; }
  .outfit-item-body table { font-size: 0.85rem; }
  .admin-form-card { padding: 1rem !important; }
  .admin-form-card .btn { width: 100%; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; }
  .admin-form-card div[style*="display:flex"][style*="justify-content:center"] { flex-direction: column !important; gap: 0.5rem !important; }
  h1 { font-size: 1.5rem; }
  h3 { font-size: 1.05rem; }
}
</style>

<script>
document.querySelectorAll('.outfit-item-header').forEach(function(header) {
  header.addEventListener('click', function(e) {
    if (e.target.closest('a') || e.target.closest('button')) return;
    header.closest('.outfit-item').classList.toggle('open');
  });
});
</script>
