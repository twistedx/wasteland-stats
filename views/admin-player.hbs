<section id="admin-section">
  {{> admin-nav}}

  {{#if successMessage}}
    <div class="notice success-notice"><strong>Success</strong><p>{{successMessage}}</p></div>
  {{/if}}
  {{#if errorMessage}}
    <div class="error">{{errorMessage}}</div>
  {{/if}}

  <!-- Player Header -->
  <div class="player-profile-header">
    <div>
      <h1 class="player-profile-name">{{#if profile.arma_username}}{{profile.arma_username}}{{else}}Unknown Player{{/if}}</h1>
      <div class="player-profile-meta">
        <code>{{profile.arma_id}}</code>
        {{#if profile.steamId}}
          <a href="https://steamcommunity.com/profiles/{{profile.steamId}}" target="_blank" rel="noopener" class="player-steam-link">Steam Profile</a>
        {{/if}}
        {{#if profile.discordId}}
          <span style="font-size:0.75rem;color:var(--text-secondary);">Discord: <code>{{profile.discordId}}</code></span>
        {{/if}}
      </div>
      <div style="display:flex;gap:1.25rem;flex-wrap:wrap;margin-top:0.35rem;font-size:0.8rem;color:var(--text-secondary);">
        {{#if profile.lastLogin}}
          <span>Last Login: <strong style="color:var(--text-primary);" id="last-login-ts" data-ts="{{profile.lastLogin}}">{{profile.lastLogin}}</strong></span>
        {{/if}}
        {{#if profile.accountCreated}}
          <span>Account Created: <strong style="color:var(--text-primary);" id="account-created-ts" data-ts="{{profile.accountCreated}}">{{profile.accountCreated}}</strong></span>
        {{/if}}
        {{#if profile.timePlayed}}
          <span>Time Played: <strong style="color:var(--text-primary);">{{profile.timePlayed}} min</strong></span>
        {{/if}}
      </div>
      {{#if profile.previousNames.length}}
        <div style="margin-top:0.5rem;font-size:0.8rem;color:var(--text-secondary);display:flex;align-items:center;flex-wrap:wrap;gap:0.4rem;">
          <span>Previous names:</span>
          {{#each profile.previousNames}}
            <span style="background:rgba(251,191,36,0.12);border:1px solid rgba(251,191,36,0.3);color:#fbbf24;padding:0.15rem 0.5rem;border-radius:999px;font-size:0.72rem;font-weight:600;">{{this}}</span>
          {{/each}}
        </div>
      {{/if}}
    </div>
    <div class="player-profile-badges">
      {{#if profile.watchlist}}
        <span class="badge badge-warning">Watchlisted</span>
      {{/if}}
      {{#if profile.vacInfo}}
        {{#if profile.vacInfo.vac_banned}}
          <span class="badge badge-danger">VAC BANNED</span>
        {{/if}}
        {{#if profile.vacInfo.number_of_game_bans}}
          <span class="badge badge-warning">GAME BAN</span>
        {{/if}}
      {{/if}}
      {{#if profile.bans.length}}
        <span class="badge badge-danger">SERVER BANNED</span>
      {{else}}
        <span class="badge badge-clean">Active</span>
      {{/if}}
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="admin-form-card" style="display:flex;gap:0.75rem;flex-wrap:wrap;padding:0.75rem 1rem;align-items:center;">
    {{#if profile.watchlist}}
      <form method="POST" action="/admin/watchlist" style="margin:0;">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <input type="hidden" name="arma_id" value="{{profile.arma_id}}">
        <input type="hidden" name="action" value="remove">
        <button type="submit" class="btn btn-admin btn-small" style="background:#22c55e;color:#fff;">Remove from Watchlist</button>
      </form>
    {{else}}
      <form method="POST" action="/admin/watchlist" style="margin:0;">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <input type="hidden" name="arma_id" value="{{profile.arma_id}}">
        <input type="hidden" name="action" value="add">
        <button type="submit" class="btn btn-admin btn-small" style="background:var(--danger);color:#fff;">Add to Watchlist</button>
      </form>
    {{/if}}
    <a href="/admin/watchlist?search={{profile.arma_username}}" class="btn btn-admin btn-small" style="text-decoration:none;">View in Watchlist</a>
  </div>

  <div class="player-profile-grid">
    <!-- Combat Stats (tabbed: Current Season / All-Time) -->
    <div class="admin-form-card">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;margin-bottom:0.75rem;">
        <h3 style="margin:0;">Combat Stats</h3>
        <div class="stats-tabs" style="display:flex;gap:0.25rem;background:var(--bg-primary);border:1px solid var(--border);border-radius:6px;padding:0.2rem;">
          <button type="button" class="stats-tab-btn active" data-stats="season" style="background:var(--accent);color:#000;border:none;padding:0.35rem 0.75rem;border-radius:4px;font-size:0.75rem;font-weight:700;cursor:pointer;">Current Season</button>
          <button type="button" class="stats-tab-btn" data-stats="alltime" style="background:transparent;color:var(--text-secondary);border:none;padding:0.35rem 0.75rem;border-radius:4px;font-size:0.75rem;font-weight:700;cursor:pointer;">All-Time</button>
        </div>
      </div>

      <div class="stats-panel" data-stats-panel="season">
        {{#if profile.stats}}
          <div class="player-stats-grid">
            <div class="player-stat">
              <span class="player-stat-value" style="color:#ef4444;">{{profile.stats.kill_count}}</span>
              <span class="player-stat-label">Kills</span>
            </div>
            <div class="player-stat">
              <span class="player-stat-value">{{profile.stats.deaths}}</span>
              <span class="player-stat-label">Deaths</span>
            </div>
            <div class="player-stat">
              <span class="player-stat-value" style="color:#4fc3f7;">{{profile.stats.kdRatio}}</span>
              <span class="player-stat-label">K/D Ratio</span>
            </div>
            {{#if profile.stats.mostKilled}}
              <div class="player-stat">
                <span class="player-stat-value">{{profile.stats.mostKilled}}</span>
                <span class="player-stat-label">Most Killed ({{profile.stats.mostKilledCount}}x)</span>
              </div>
            {{/if}}
            {{#if profile.stats.mostKilledBy}}
              <div class="player-stat">
                <span class="player-stat-value">{{profile.stats.mostKilledBy}}</span>
                <span class="player-stat-label">Nemesis ({{profile.stats.mostKilledByCount}}x)</span>
              </div>
            {{/if}}
          </div>
        {{else}}
          <div class="empty-state">No current season stats available.</div>
        {{/if}}
      </div>

      <div class="stats-panel" data-stats-panel="alltime" style="display:none;">
        {{#if profile.allTimeStats}}
          <div class="player-stats-grid">
            <div class="player-stat">
              <span class="player-stat-value" style="color:#ef4444;">{{profile.allTimeStats.kill_count}}</span>
              <span class="player-stat-label">Kills</span>
            </div>
            <div class="player-stat">
              <span class="player-stat-value">{{profile.allTimeStats.deaths}}</span>
              <span class="player-stat-label">Deaths</span>
            </div>
            <div class="player-stat">
              <span class="player-stat-value" style="color:#4fc3f7;">{{profile.allTimeStats.kdRatio}}</span>
              <span class="player-stat-label">K/D Ratio</span>
            </div>
            {{#if profile.allTimeStats.mostKilled}}
              <div class="player-stat">
                <span class="player-stat-value">{{profile.allTimeStats.mostKilled}}</span>
                <span class="player-stat-label">Most Killed ({{profile.allTimeStats.mostKilledCount}}x)</span>
              </div>
            {{/if}}
            {{#if profile.allTimeStats.mostKilledBy}}
              <div class="player-stat">
                <span class="player-stat-value">{{profile.allTimeStats.mostKilledBy}}</span>
                <span class="player-stat-label">Nemesis ({{profile.allTimeStats.mostKilledByCount}}x)</span>
              </div>
            {{/if}}
          </div>
        {{else}}
          <div class="empty-state">No all-time stats available.</div>
        {{/if}}
      </div>
    </div>

    <!-- Economy -->
    <div class="admin-form-card">
      <h3>Economy</h3>
      <div class="player-stats-grid">
        <div class="player-stat">
          <span class="player-stat-value" style="color:#22c55e;">{{#if profile.cashBalance}}${{formatNumber profile.cashBalance}}{{else}}$0{{/if}}</span>
          <span class="player-stat-label">Cash Balance</span>
        </div>
        <div class="player-stat">
          <span class="player-stat-value" style="color:#fbbf24;">{{#if profile.atmLimit}}${{formatNumber profile.atmLimit}}{{else}}$150,000{{/if}}</span>
          <span class="player-stat-label">ATM Limit</span>
        </div>
        <div class="player-stat">
          <span class="player-stat-value" style="color:#fbbf24;">{{#if profile.discordId}}🪙 {{formatNumber profile.wastedCoinsBalance}}{{else}}<span style="color:var(--text-muted);font-size:0.85rem;">no Discord</span>{{/if}}</span>
          <span class="player-stat-label">Wasted Coins</span>
        </div>
      </div>
    </div>

    <!-- Ban History -->
    <div class="admin-form-card">
      <h3>Ban History</h3>
      {{#if profile.bans.length}}
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Ban ID</th>
                <th>Admin</th>
                <th>Reason</th>
                <th>Duration</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody>
              {{#each profile.bans}}
                <tr>
                  <td class="guid" style="font-family:monospace;font-size:0.75rem;">{{#if this.id}}{{this.id}}{{else if this.ban_id}}{{this.ban_id}}{{else}}—{{/if}}</td>
                  <td class="player-name">{{this.admin_name}}</td>
                  <td>{{this.reason}}</td>
                  <td>{{#if (eq this.duration_hours -1)}}Permanent{{else}}{{this.duration_hours}}h{{/if}}</td>
                  <td>{{formatDate this.time_stamp}}</td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      {{else}}
        <div class="empty-state">No bans on record.</div>
      {{/if}}
    </div>

    <!-- Daily Kills + Detailed Stats — 50/50 full-width row -->
    <div style="grid-column:1/-1;display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:1rem;">
      <div class="admin-form-card" style="margin:0;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem;flex-wrap:wrap;gap:0.5rem;">
          <h3 style="margin:0;">Daily Kills &amp; Deaths</h3>
          <span id="daily-stats-period-label" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-secondary);">Last 30 Days</span>
        </div>
        <div class="daily-stats-windows" style="display:flex;gap:0.25rem;background:var(--bg-primary);border:1px solid var(--border);border-radius:6px;padding:0.2rem;width:fit-content;margin-bottom:0.75rem;flex-wrap:wrap;">
          <button type="button" class="daily-window-btn active" data-window="30" style="background:var(--accent);color:#000;border:none;padding:0.3rem 0.7rem;border-radius:4px;font-size:0.72rem;font-weight:700;cursor:pointer;">30D</button>
          <button type="button" class="daily-window-btn" data-window="60" style="background:transparent;color:var(--text-secondary);border:none;padding:0.3rem 0.7rem;border-radius:4px;font-size:0.72rem;font-weight:700;cursor:pointer;">60D</button>
          <button type="button" class="daily-window-btn" data-window="90" style="background:transparent;color:var(--text-secondary);border:none;padding:0.3rem 0.7rem;border-radius:4px;font-size:0.72rem;font-weight:700;cursor:pointer;">90D</button>
          <button type="button" class="daily-window-btn" data-window="180" style="background:transparent;color:var(--text-secondary);border:none;padding:0.3rem 0.7rem;border-radius:4px;font-size:0.72rem;font-weight:700;cursor:pointer;">180D</button>
          <button type="button" class="daily-window-btn" data-window="365" style="background:transparent;color:var(--text-secondary);border:none;padding:0.3rem 0.7rem;border-radius:4px;font-size:0.72rem;font-weight:700;cursor:pointer;">1Y</button>
          <button type="button" class="daily-window-btn" data-window="all" style="background:transparent;color:var(--text-secondary);border:none;padding:0.3rem 0.7rem;border-radius:4px;font-size:0.72rem;font-weight:700;cursor:pointer;">All</button>
        </div>
        <div id="daily-stats-empty" class="empty-state" style="display:none;">No daily kill/death history available yet for this period.</div>
        <div id="daily-stats-chart" style="width:100%;height:280px;"></div>
      </div>

      {{#if profile.miscStats.length}}
      <div class="admin-form-card" style="margin:0;">
        <h3>Detailed Stats</h3>
        <div class="player-misc-grid">
          {{#each profile.miscStats}}
            <div class="player-misc-item">
              <span class="player-misc-value">{{formatNumber this.value}}</span>
              <span class="player-misc-label">{{this.label}}</span>
            </div>
          {{/each}}
        </div>
      </div>
      {{/if}}
    </div>

    {{#if user.isOwner}}
    <!-- Owner-only: Manual Discord Link -->
    <div class="admin-form-card" style="border-left:4px solid #a855f7;">
      <h3 style="display:flex;align-items:center;gap:0.5rem;">🔗 Discord Link <span style="background:rgba(168,85,247,0.18);color:#c084fc;font-size:0.6rem;font-weight:700;padding:0.15rem 0.5rem;border-radius:999px;text-transform:uppercase;letter-spacing:0.05em;">Owner</span></h3>
      <p style="color:var(--text-secondary);font-size:0.78rem;margin:0 0 0.75rem;">Manually link a Discord ID when the in-game <code>/verify</code> flow can't be used. Currently linked: <strong style="color:{{#if profile.discordId}}#22c55e{{else}}var(--text-muted){{/if}};">{{#if profile.discordId}}{{profile.discordId}}{{else}}— none —{{/if}}</strong></p>
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;">
        <form method="POST" action="/admin/player/{{profile.arma_id}}/link-discord" style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;flex:1;min-width:280px;margin:0;">
          <input type="hidden" name="_csrf" value="{{csrfToken}}">
          <input type="hidden" name="action" value="set">
          <input type="text" name="discord_id" class="filter-input" placeholder="Discord ID (17–20 digits, e.g. 196638769133125633)" pattern="\d{17,20}" required style="flex:1;min-width:280px;">
          <button type="submit" class="btn btn-admin btn-small" style="background:#a855f7;color:#fff;">Link Discord</button>
        </form>
        {{#if profile.discordId}}
          <form method="POST" action="/admin/player/{{profile.arma_id}}/link-discord" style="margin:0;" onsubmit="return confirm('Unlink the current Discord ID?');">
            <input type="hidden" name="_csrf" value="{{csrfToken}}">
            <input type="hidden" name="action" value="unlink">
            <button type="submit" class="btn btn-admin btn-small" style="background:var(--danger);color:#fff;">Unlink</button>
          </form>
        {{/if}}
      </div>
    </div>
    {{/if}}

    <!-- VAC Status -->
    <div class="admin-form-card">
      <h3>VAC Status</h3>
      {{#if profile.vacInfo}}
        <div class="player-stats-grid">
          <div class="player-stat">
            <span class="player-stat-value" style="color:{{#if profile.vacInfo.vac_banned}}#ef4444{{else}}#4ade80{{/if}};">{{#if profile.vacInfo.vac_banned}}BANNED{{else}}Clean{{/if}}</span>
            <span class="player-stat-label">VAC Status</span>
          </div>
          <div class="player-stat">
            <span class="player-stat-value">{{profile.vacInfo.number_of_vac_bans}}</span>
            <span class="player-stat-label">VAC Bans</span>
          </div>
          <div class="player-stat">
            <span class="player-stat-value">{{profile.vacInfo.number_of_game_bans}}</span>
            <span class="player-stat-label">Game Bans</span>
          </div>
          <div class="player-stat">
            <span class="player-stat-value">{{profile.vacInfo.days_since_last_ban}}d</span>
            <span class="player-stat-label">Days Since Ban</span>
          </div>
        </div>
      {{else if profile.steamId}}
        <div class="empty-state">Not scanned yet. <a href="https://steamcommunity.com/profiles/{{profile.steamId}}" target="_blank" rel="noopener" style="color:var(--accent);">View Steam Profile</a></div>
      {{else}}
        <div class="empty-state">No Steam ID linked.</div>
      {{/if}}
    </div>

    <!-- Notes -->
    <div class="admin-form-card">
      <h3>Admin Notes</h3>
      <form method="POST" action="/admin/player/{{profile.arma_id}}/note" style="display:flex;gap:0.5rem;align-items:flex-start;">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <textarea name="note" class="filter-input" rows="2" placeholder="Add a note..." style="flex:1;resize:vertical;"></textarea>
        <button type="submit" class="btn btn-admin btn-small" style="margin-top:0.1rem;">Add Note</button>
      </form>
      <p style="color:var(--text-secondary);font-size:0.72rem;margin:0.4rem 0 0;">💡 Create a note first, then you can attach images (≤5 MB) or video clips (≤500 MB — auto-compressed to H.264 720p) as evidence.</p>

      {{#if playerNotes.length}}
      <div class="player-notes-timeline">
        {{#each playerNotes}}
          <div class="player-note">
            <div class="player-note-header">
              <span class="player-note-author">{{this.admin_username}}</span>
              <span class="player-note-date">{{formatDate this.created_at}}</span>
              <form method="POST" action="/admin/player/{{@root.profile.arma_id}}/note/{{this.id}}/delete" style="margin:0;" onsubmit="return confirm('Delete this note and all attachments?');">
                <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
                <button type="submit" class="player-note-delete" title="Delete">&times;</button>
              </form>
            </div>
            <div class="player-note-body">{{this.note}}</div>

            {{#if this.attachmentsArr.length}}
              <div class="player-note-attachments" style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-top:0.5rem;">
                {{#each this.attachmentsArr}}
                  <div class="note-attachment" style="position:relative;border:1px solid var(--border);border-radius:6px;overflow:hidden;max-width:220px;">
                    {{#if (eq this.type 'image')}}
                      <a href="/admin/uploads/note/{{@root.profile.arma_id}}/{{this.filename}}" target="_blank" rel="noopener">
                        <img src="/admin/uploads/note/{{@root.profile.arma_id}}/{{this.filename}}" style="display:block;width:100%;max-height:180px;object-fit:cover;" alt="attachment">
                      </a>
                    {{else}}
                      <video controls preload="metadata" style="display:block;width:100%;max-height:180px;background:#000;">
                        <source src="/admin/uploads/note/{{@root.profile.arma_id}}/{{this.filename}}">
                      </video>
                    {{/if}}
                    <div style="padding:0.35rem 0.5rem;font-size:0.7rem;display:flex;justify-content:space-between;align-items:center;background:var(--bg-primary);gap:0.35rem;">
                      <span style="color:var(--text-secondary);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;min-width:0;" title="{{this.original_name}}{{#if this.original_size}} — original: {{formatBytes this.original_size}}, stored: {{formatBytes this.size}}{{/if}}">{{this.original_name}}</span>
                      <span style="color:var(--text-muted);font-size:0.65rem;white-space:nowrap;">{{formatBytes this.size}}</span>
                      <form method="POST" action="/admin/player/{{@root.profile.arma_id}}/note/{{../id}}/attach/{{this.filename}}/delete" style="margin:0;" onsubmit="return confirm('Remove this attachment?');">
                        <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
                        <button type="submit" style="background:transparent;border:none;color:var(--danger);cursor:pointer;font-size:1rem;padding:0 0.25rem;" title="Delete">&times;</button>
                      </form>
                    </div>
                  </div>
                {{/each}}
              </div>
            {{/if}}

            <form method="POST" action="/admin/player/{{@root.profile.arma_id}}/note/{{this.id}}/attach?_csrf={{@root.csrfToken}}" enctype="multipart/form-data" style="display:flex;gap:0.5rem;align-items:center;margin-top:0.5rem;font-size:0.75rem;">
              <input type="file" name="file" accept="image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,video/quicktime" required style="flex:1;font-size:0.75rem;">
              <button type="submit" class="btn btn-admin btn-small">Attach</button>
            </form>
          </div>
        {{/each}}
      </div>
      <p style="color:var(--text-secondary);font-size:0.7rem;margin-top:0.5rem;">Attach images (max 5 MB) or video clips (max 100 MB) to any note as evidence.</p>
      {{/if}}
    </div>

    <div class="admin-form-card" style="grid-column:1/-1;">
      <h3>Server History ({{profile.serverHistory.length}})</h3>
      {{#if profile.serverHistory.length}}
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Server</th>
                <th>First Seen</th>
                <th>Last Seen</th>
                <th style="text-align:right;">Visits</th>
              </tr>
            </thead>
            <tbody>
              {{#each profile.serverHistory}}
                <tr>
                  <td style="font-weight:600;">{{this.server_name}}</td>
                  <td class="history-ts" data-ts="{{this.first_seen}}">{{this.first_seen}}</td>
                  <td class="history-ts" data-ts="{{this.last_seen}}">{{this.last_seen}}</td>
                  <td style="text-align:right;font-weight:700;color:var(--accent);">{{this.visit_count}}</td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      {{else}}
        <div class="empty-state">No server history recorded.</div>
      {{/if}}
    </div>

    <div class="admin-form-card skins-accordion-card" style="grid-column:1/-1;padding:0;overflow:hidden;">
      <button type="button" class="skins-accordion-toggle" style="width:100%;display:flex;justify-content:space-between;align-items:center;padding:1rem 1.25rem;background:transparent;border:0;color:var(--text-primary);cursor:pointer;font-family:inherit;text-align:left;">
        <h3 style="margin:0;font-size:1.05rem;">🎨 Owned Skins &amp; Items ({{profile.ownedSkins.length}})</h3>
        <span class="skins-accordion-arrow" style="font-size:0.8rem;color:var(--text-secondary);transition:transform 0.2s;">&#9662;</span>
      </button>
      <div class="skins-accordion-body" style="display:none;padding:0 1.25rem 1.25rem;border-top:1px solid var(--border);">
        {{#unless profile.discordId}}
          <div class="empty-state" style="margin-top:1rem;">No Discord account linked — can't query owned items.</div>
        {{else if profile.ownedSkins.length}}
          <div class="table-scroll" style="margin-top:1rem;">
            <table>
              <thead>
                <tr>
                  <th>Item</th>
                  <th>Rarity</th>
                  <th style="text-align:right;">Qty</th>
                  <th>Granted</th>
                </tr>
              </thead>
              <tbody>
                {{#each profile.ownedSkins}}
                  <tr>
                    <td style="font-weight:600;">{{this.name}}</td>
                    <td>{{#if this.rarity}}<span style="text-transform:uppercase;letter-spacing:0.04em;font-size:0.75rem;color:var(--text-secondary);">{{this.rarity}}</span>{{else}}<span style="color:var(--text-muted);">—</span>{{/if}}</td>
                    <td style="text-align:right;font-weight:700;color:var(--accent);">{{this.quantity}}</td>
                    <td>{{#if this.date}}<span class="history-ts" data-ts="{{this.date}}">{{this.date}}</span>{{else}}<span style="color:var(--text-muted);">—</span>{{/if}}</td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        {{else}}
          <div class="empty-state" style="margin-top:1rem;">No skins or items granted yet.</div>
        {{/unless}}
      </div>
    </div>
  </div>
</section>

<script nonce="{{cspNonce}}">
(function() {
  document.querySelectorAll('.skins-accordion-toggle').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var body = btn.parentElement.querySelector('.skins-accordion-body');
      var arrow = btn.querySelector('.skins-accordion-arrow');
      var open = body.style.display === 'block';
      body.style.display = open ? 'none' : 'block';
      if (arrow) arrow.style.transform = open ? '' : 'rotate(180deg)';
    });
  });
})();
</script>

{{> ban-modal}}

<script nonce="{{cspNonce}}">
(function() {
  function fmt(el) {
    if (!el) return;
    var ts = el.dataset.ts;
    if (!ts) return;
    var d = new Date(ts);
    if (isNaN(d)) return;
    var now = new Date();
    var diff = now - d;
    var mins = Math.floor(diff / 60000);
    var hrs = Math.floor(diff / 3600000);
    var days = Math.floor(diff / 86400000);
    var ago = mins < 1 ? 'just now' : mins < 60 ? mins + 'm ago' : hrs < 24 ? hrs + 'h ago' : days + 'd ago';
    el.textContent = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) + ' ' + d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) + ' (' + ago + ')';
  }
  fmt(document.getElementById('last-login-ts'));
  fmt(document.getElementById('account-created-ts'));
  document.querySelectorAll('.history-ts').forEach(fmt);

  // Combat Stats tab toggle
  document.querySelectorAll('.stats-tab-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var target = this.dataset.stats;
      document.querySelectorAll('.stats-tab-btn').forEach(function(b) {
        var active = b.dataset.stats === target;
        b.classList.toggle('active', active);
        b.style.background = active ? 'var(--accent)' : 'transparent';
        b.style.color = active ? '#000' : 'var(--text-secondary)';
      });
      document.querySelectorAll('.stats-panel').forEach(function(p) {
        p.style.display = p.dataset.statsPanel === target ? '' : 'none';
      });
      if (typeof window.renderDailyStatsChart === 'function') {
        window.renderDailyStatsChart(target);
      }
    });
  });
})();
</script>

<script src="https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js"></script>
<script nonce="{{cspNonce}}">
(function() {
  var seasonData = {{{json profile.dailyStatsSeason}}};
  var allTimeData = {{{json profile.dailyStatsAllTime}}};
  var el = document.getElementById('daily-stats-chart');
  var emptyEl = document.getElementById('daily-stats-empty');
  var labelEl = document.getElementById('daily-stats-period-label');
  if (!el || typeof echarts === 'undefined') return;
  var chart = null;

  // State: which dataset (season/alltime) and which day window
  var activePeriod = 'alltime';
  var activeWindow = 30;

  var WINDOW_LABELS = { 30: 'Last 30 Days', 60: 'Last 60 Days', 90: 'Last 90 Days', 180: 'Last 180 Days', 365: 'Last Year', all: 'All-Time' };

  function applyWindow(data) {
    if (!data || !data.length) return [];
    if (activeWindow === 'all') return data;
    var cutoff = new Date(Date.now() - activeWindow * 86400000).toISOString().slice(0, 10);
    return data.filter(function(d) { return d.date >= cutoff; });
  }

  function render() {
    var src = activePeriod === 'alltime' ? allTimeData : seasonData;
    var data = applyWindow(src);
    if (labelEl) labelEl.textContent = WINDOW_LABELS[activeWindow] || ('Last ' + activeWindow + ' Days');
    if (!data || !data.length) {
      el.style.display = 'none';
      emptyEl.style.display = '';
      if (chart) { chart.dispose(); chart = null; }
      return;
    }
    el.style.display = '';
    emptyEl.style.display = 'none';
    if (!chart) chart = echarts.init(el);
    chart.setOption({
      backgroundColor: 'transparent',
      textStyle: { fontFamily: 'Rajdhani, sans-serif', color: '#9a9a9a' },
      tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' } },
      legend: { data: ['Kills', 'Deaths'], textStyle: { color: '#fff' }, top: 0 },
      grid: { left: '3%', right: '3%', bottom: '8%', top: '15%', containLabel: true },
      xAxis: {
        type: 'category',
        data: data.map(function(d) { return d.date; }),
        axisLabel: { color: '#9a9a9a', rotate: 30 },
        axisLine: { lineStyle: { color: 'rgba(255,255,255,0.1)' } },
      },
      yAxis: {
        type: 'value',
        axisLabel: { color: '#9a9a9a' },
        splitLine: { lineStyle: { color: 'rgba(255,255,255,0.06)' } },
      },
      series: [
        { name: 'Kills',  type: 'bar', data: data.map(function(d) { return d.kills || 0; }),  itemStyle: { color: '#22c55e' } },
        { name: 'Deaths', type: 'bar', data: data.map(function(d) { return d.deaths || 0; }), itemStyle: { color: '#ef4444' } },
      ],
    });
  }

  // Public hook used by Combat Stats tab toggle — accepts 'season' | 'alltime'
  window.renderDailyStatsChart = function(period) {
    if (period === 'season' || period === 'alltime') activePeriod = period;
    render();
  };

  // Day-window buttons
  document.querySelectorAll('.daily-window-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var w = btn.dataset.window;
      activeWindow = (w === 'all') ? 'all' : parseInt(w, 10);
      document.querySelectorAll('.daily-window-btn').forEach(function(b) {
        var active = b === btn;
        b.classList.toggle('active', active);
        b.style.background = active ? 'var(--accent)' : 'transparent';
        b.style.color = active ? '#000' : 'var(--text-secondary)';
      });
      render();
    });
  });

  render();
  window.addEventListener('resize', function() { if (chart) chart.resize(); });
})();
</script>

