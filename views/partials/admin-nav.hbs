<h2>Admin</h2>
<div class="tab-bar admin-tab-bar">
  <button class="admin-hamburger" id="admin-hamburger" aria-label="Toggle menu">
    <span></span><span></span><span></span>
  </button>
  <div class="admin-tabs" id="admin-tabs">
    <a href="/admin/analytics" class="tab {{#if (eq activeTab 'analytics')}}active{{/if}}">Analytics</a>

    <!-- Moderation dropdown -->
    <div class="admin-dropdown">
      <button class="tab admin-dropdown-toggle {{#if (or (or (eq activeTab 'bans') (eq activeTab 'kills')) (eq activeTab 'watchlist'))}}active{{/if}}">
        Moderation <span class="dropdown-arrow">&#9662;</span>
      </button>
      <div class="admin-dropdown-menu">
        <a href="/admin/bans" class="admin-dropdown-item {{#if (eq activeTab 'bans')}}active{{/if}}">Ban List</a>
        <a href="/admin/kills" class="admin-dropdown-item {{#if (eq activeTab 'kills')}}active{{/if}}">Kill Log</a>
        <a href="/admin/watchlist" class="admin-dropdown-item {{#if (eq activeTab 'watchlist')}}active{{/if}}">Watchlist</a>
      </div>
    </div>

    {{#if user.isWriteAdmin}}
    <!-- Utilities dropdown -->
    <div class="admin-dropdown">
      <button class="tab admin-dropdown-toggle {{#if (or (eq activeTab 'money') (eq activeTab 'skins'))}}active{{/if}}">
        Utilities <span class="dropdown-arrow">&#9662;</span>
      </button>
      <div class="admin-dropdown-menu">
        <a href="/admin/money" class="admin-dropdown-item {{#if (eq activeTab 'money')}}active{{/if}}">Add Money</a>
        <a href="/admin/skins" class="admin-dropdown-item {{#if (eq activeTab 'skins')}}active{{/if}}">Skins</a>
      </div>
    </div>
    {{/if}}

    {{#if user.isBlogAdmin}}
      <a href="/admin/blog" class="tab {{#if (eq activeTab 'blog')}}active{{/if}}">Blog</a>
    {{/if}}
    <a href="/admin/servers" class="tab {{#if (eq activeTab 'servers')}}active{{/if}}">Servers</a>
    <a href="/admin/system" class="tab {{#if (eq activeTab 'system')}}active{{/if}}">System</a>
  </div>
  <div class="admin-tab-actions">
    <button type="button" id="open-unban-modal" class="btn btn-admin btn-small" style="background:#22c55e;color:#fff;">Unban Player</button>
    <button type="button" id="open-ban-modal" class="btn btn-admin btn-small" style="background:var(--danger);color:#fff;">Ban Player</button>
  </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function() {
  var btn = document.getElementById('admin-hamburger');
  var tabs = document.getElementById('admin-tabs');
  if (!btn || !tabs) return;
  btn.addEventListener('click', function(e) {
    e.preventDefault();
    e.stopPropagation();
    btn.classList.toggle('open');
    tabs.classList.toggle('open');
  });
  // Close menu when a tab is clicked
  tabs.querySelectorAll('.tab:not(.admin-dropdown-toggle)').forEach(function(tab) {
    tab.addEventListener('click', function() {
      btn.classList.remove('open');
      tabs.classList.remove('open');
    });
  });
  tabs.querySelectorAll('.admin-dropdown-item').forEach(function(item) {
    item.addEventListener('click', function() {
      btn.classList.remove('open');
      tabs.classList.remove('open');
    });
  });

  // Dropdown toggle logic
  document.querySelectorAll('.admin-dropdown-toggle').forEach(function(toggle) {
    toggle.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      var dropdown = this.closest('.admin-dropdown');
      var wasOpen = dropdown.classList.contains('open');
      // Close all dropdowns first
      document.querySelectorAll('.admin-dropdown').forEach(function(d) { d.classList.remove('open'); });
      if (!wasOpen) dropdown.classList.add('open');
    });
  });

  // Close dropdowns when clicking outside
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.admin-dropdown')) {
      document.querySelectorAll('.admin-dropdown').forEach(function(d) { d.classList.remove('open'); });
    }
    if (!btn.contains(e.target) && !tabs.contains(e.target)) {
      btn.classList.remove('open');
      tabs.classList.remove('open');
    }
  });
});
</script>
