<section id="admin-section">
  {{> admin-nav}}

  {{#if successMessage}}
    <div class="notice success-notice">
      <strong>Success</strong>
      <p>{{successMessage}}</p>
    </div>
  {{/if}}

  {{#if errorMessage}}
    <div class="error">{{errorMessage}}</div>
  {{/if}}

  <div class="admin-form-card" style="display:flex;align-items:center;justify-content:space-between;padding:1rem 1.25rem;flex-wrap:wrap;gap:0.75rem;">
    <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
      <form method="POST" action="/admin/store/sync-stripe" style="margin:0;" onsubmit="this.querySelector('button').disabled=true;this.querySelector('button').textContent='Syncing...';">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <button type="submit" class="btn btn-admin" style="background:#5865F2;">Sync to Stripe</button>
      </form>
      <form method="POST" action="/admin/store/sync-production" style="margin:0;" onsubmit="if(!confirm('Push all store data to production? This will update products, categories, and draw pool on the live server.'))return false;this.querySelector('button').disabled=true;this.querySelector('button').textContent='Syncing...';">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <button type="submit" class="btn btn-admin" style="background:#ef4444;">Sync to Production</button>
      </form>
    </div>
    <span style="color:var(--text-secondary);font-size:0.8rem;">Push products, categories, and draw pool to Stripe or production.</span>
  </div>

  <div class="admin-form-card">
    <div style="display:flex;gap:0;margin-bottom:1.25rem;border-bottom:1px solid var(--border);">
      <button class="tab store-add-tab active" data-tab="tab-product" type="button">Add New Product</button>
      <button class="tab store-add-tab" data-tab="tab-category" type="button">Add Category</button>
    </div>

    <div id="tab-product">
      <form method="POST" action="/admin/store?_csrf={{csrfToken}}" class="money-form" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
          <div class="form-group">
            <label class="form-label">Name</label>
            <input type="text" name="name" class="filter-input" placeholder="e.g. The Cowboy" required>
          </div>
          <div class="form-group">
            <label class="form-label">Category</label>
            <select name="category" class="filter-select" required>
              {{#each categories}}
                <option value="{{this.slug}}">{{this.label}}</option>
              {{/each}}
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Price (USD)</label>
            <input type="number" name="price" class="filter-input" step="0.01" min="0.50" placeholder="29.99" required>
          </div>
          <div class="form-group">
            <label class="form-label">Sale Price (USD, leave blank for none)</label>
            <input type="number" name="sale_price" class="filter-input" step="0.01" min="0" placeholder="">
          </div>
          <div class="form-group">
            <label class="form-label">Upload Image</label>
            <input type="file" name="image_file" accept=".jpg,.jpeg,.png,.webp" class="filter-input" style="padding:0.35rem;">
          </div>
          <div class="form-group">
            <label class="form-label">Badge</label>
            <select name="badge" class="filter-select">
              <option value="">None</option>
              <option value="new">New</option>
              <option value="sale">Sale</option>
              <option value="limited">Leaving Soon</option>
            </select>
          </div>
          <div class="form-group" style="grid-column:span 2;">
            <label class="form-label">Description</label>
            <input type="text" name="description" class="filter-input" placeholder="Short description of the product">
          </div>
          <div class="form-group">
            <label class="form-label">Sort Order</label>
            <input type="number" name="sort_order" class="filter-input" value="0" min="0">
          </div>
        </div>
        <button type="submit" class="btn btn-admin" style="margin-top:1rem;">Add Product</button>
      </form>
    </div>

    <div id="tab-category" style="display:none;">
      <form method="POST" action="/admin/store/category" class="money-form">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
          <div class="form-group">
            <label class="form-label">Slug</label>
            <input type="text" name="slug" class="filter-input" placeholder="e.g. weapons" required>
          </div>
          <div class="form-group">
            <label class="form-label">Label</label>
            <input type="text" name="label" class="filter-input" placeholder="e.g. Weapon Skins" required>
          </div>
          <div class="form-group">
            <label class="form-label">Sort Order</label>
            <input type="number" name="sort_order" class="filter-input" value="0" min="0">
          </div>
          <div class="form-group">
            <label class="form-label">Description</label>
            <input type="text" name="description" class="filter-input" placeholder="Shown below the heading on the store page">
          </div>
        </div>
        <button type="submit" class="btn btn-admin" style="margin-top:1rem;">Add Category</button>
      </form>
    </div>
  </div>

  <div class="admin-form-card">
    <h3>Store Products ({{products.length}})</h3>
    {{#if products.length}}
      <div class="table-scroll">
        <table id="store-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>Category</th>
              <th>Price</th>
              <th>Sale</th>
              <th>Badge</th>
              <th>Active</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {{#each products}}
              <tr class="store-row-toggle" style="cursor:pointer;" title="Click to edit">
                <td>{{this.id}}</td>
                <td>{{this.name}}</td>
                <td><span class="skin-tag">{{this.category}}</span></td>
                <td>${{this.priceDisplay}}</td>
                <td>{{#if this.sale_price}}<span style="color:#22c55e;">${{this.salePriceDisplay}}</span>{{else}}-{{/if}}</td>
                <td>{{#if this.badge}}<span class="skin-tag">{{this.badge}}</span>{{else}}-{{/if}}</td>
                <td>{{#if this.active}}<span style="color:#22c55e;">Yes</span>{{else}}<span style="color:var(--danger);">No</span>{{/if}}</td>
                <td>
                  <form method="POST" action="/admin/store/delete/{{this.id}}" style="display:inline;">
                    <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                    <button type="submit" class="btn btn-small" onclick="return confirm('Delete {{this.name}}?')">Delete</button>
                  </form>
                </td>
              </tr>
              <tr class="store-edit-row" style="display:none;">
                <td colspan="8" style="padding:1rem;background:var(--bg-primary);border-bottom:1px solid var(--border);">
                  <form method="POST" action="/admin/store/edit/{{this.id}}?_csrf={{../csrfToken}}" class="money-form" enctype="multipart/form-data">
                    <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:0.75rem;">
                      <div class="form-group">
                        <label class="form-label">Name</label>
                        <input type="text" name="name" class="filter-input" value="{{this.name}}" required>
                      </div>
                      <div class="form-group">
                        <label class="form-label">Category</label>
                        <select name="category" class="filter-select">
                          {{#each ../categories}}
                            <option value="{{this.slug}}" {{#if (eq this.slug ../category)}}selected{{/if}}>{{this.label}}</option>
                          {{/each}}
                        </select>
                      </div>
                      <div class="form-group">
                        <label class="form-label">Price (USD)</label>
                        <input type="number" name="price" class="filter-input" step="0.01" min="0.50" value="{{this.priceDisplay}}" required>
                      </div>
                      <div class="form-group">
                        <label class="form-label">Sale Price (blank = none)</label>
                        <input type="number" name="sale_price" class="filter-input" step="0.01" min="0" value="{{this.salePriceDisplay}}">
                      </div>
                      <div class="form-group">
                        <label class="form-label">Upload New Image</label>
                        <input type="file" name="image_file" accept=".jpg,.jpeg,.png,.webp" class="filter-input" style="padding:0.35rem;">
                      </div>
                      <div class="form-group">
                        <label class="form-label">Badge</label>
                        <select name="badge" class="filter-select">
                          <option value="" {{#unless this.badge}}selected{{/unless}}>None</option>
                          <option value="new" {{#if (eq this.badge 'new')}}selected{{/if}}>New</option>
                          <option value="limited" {{#if (eq this.badge 'limited')}}selected{{/if}}>Limited Time</option>
                          <option value="sale" {{#if (eq this.badge 'sale')}}selected{{/if}}>Sale</option>
                        </select>
                      </div>
                      <div class="form-group" style="grid-column:span 2;">
                        <label class="form-label">Description</label>
                        <input type="text" name="description" class="filter-input" value="{{this.description}}">
                      </div>
                      <div class="form-group">
                        <label class="form-label">Sort Order</label>
                        <input type="number" name="sort_order" class="filter-input" value="{{this.sort_order}}" min="0">
                      </div>
                      <div class="form-group">
                        <label class="form-label">Active</label>
                        <select name="active" class="filter-select">
                          <option value="1" {{#if this.active}}selected{{/if}}>Yes</option>
                          <option value="0" {{#unless this.active}}selected{{/unless}}>No</option>
                        </select>
                      </div>
                    </div>
                    <button type="submit" class="btn btn-admin" style="margin-top:0.75rem;">Save Changes</button>
                  </form>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div class="empty-state">No products in the store.</div>
    {{/if}}
  </div>

  <div class="admin-form-card">
    <h3>Categories ({{categories.length}})</h3>
    <div class="table-scroll" style="margin-bottom:1.5rem;">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Slug</th>
            <th>Label</th>
            <th>Description</th>
            <th>Order</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each categories}}
            <tr class="cat-row-toggle" style="cursor:pointer;" title="Click to edit">
              <td>{{this.id}}</td>
              <td><code>{{this.slug}}</code></td>
              <td>{{this.label}}</td>
              <td style="max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{this.description}}</td>
              <td>{{this.sort_order}}</td>
              <td>
                <form method="POST" action="/admin/store/category/delete/{{this.id}}" style="display:inline;">
                  <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                  <button type="submit" class="btn btn-small" onclick="return confirm('Delete category {{this.label}}? Products in this category will NOT be deleted.')">Delete</button>
                </form>
              </td>
            </tr>
            <tr class="cat-edit-row" style="display:none;">
              <td colspan="6" style="padding:1rem;background:var(--bg-primary);border-bottom:1px solid var(--border);">
                <form method="POST" action="/admin/store/category/edit/{{this.id}}" class="money-form">
                  <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                  <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:0.75rem;">
                    <div class="form-group">
                      <label class="form-label">Slug</label>
                      <input type="text" name="slug" class="filter-input" value="{{this.slug}}" required>
                    </div>
                    <div class="form-group">
                      <label class="form-label">Label</label>
                      <input type="text" name="label" class="filter-input" value="{{this.label}}" required>
                    </div>
                    <div class="form-group">
                      <label class="form-label">Sort Order</label>
                      <input type="number" name="sort_order" class="filter-input" value="{{this.sort_order}}" min="0">
                    </div>
                    <div class="form-group" style="grid-column:span 3;">
                      <label class="form-label">Description (shown on store page)</label>
                      <input type="text" name="description" class="filter-input" value="{{this.description}}">
                    </div>
                  </div>
                  <button type="submit" class="btn btn-admin" style="margin-top:0.75rem;">Save Category</button>
                </form>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

  </div>
</section>

<script>
(function() {
  function initToggle(rowClass, editClass) {
    document.querySelectorAll('.' + rowClass).forEach(function(row) {
      row.addEventListener('click', function(e) {
        if (e.target.closest('button') || e.target.closest('form')) return;
        var editRow = this.nextElementSibling;
        if (editRow && editRow.classList.contains(editClass)) {
          editRow.style.display = editRow.style.display === 'none' ? '' : 'none';
        }
      });
    });
  }
  initToggle('store-row-toggle', 'store-edit-row');
  initToggle('cat-row-toggle', 'cat-edit-row');

  // Add product / Add category tabs
  document.querySelectorAll('.store-add-tab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      document.querySelectorAll('.store-add-tab').forEach(function(t) { t.classList.remove('active'); });
      this.classList.add('active');
      document.getElementById('tab-product').style.display = 'none';
      document.getElementById('tab-category').style.display = 'none';
      document.getElementById(this.getAttribute('data-tab')).style.display = '';
    });
  });
})();
</script>

{{> ban-modal}}
