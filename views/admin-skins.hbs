<section id="admin-section">
  {{> admin-nav}}

  {{#if successMessage}}
    <div class="notice success-notice">
      <strong>Success</strong>
      <p>{{successMessage}}</p>
    </div>
  {{/if}}

  {{#if errorMessage}}
    <div class="error">{{errorMessage}}</div>
  {{/if}}

  <div class="admin-form-card">
    <h3>Assign Skin</h3>
    {{#if skinsError}}
      <div class="error">Failed to load available skins.</div>
    {{else}}
      <form method="POST" action="/admin/skins" class="money-form">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <div class="form-group">
          <label class="form-label">Discord User ID</label>
          <input
            type="text"
            name="discord_id"
            class="filter-input"
            placeholder="Right-click user in Discord → Copy User ID"
            required
          >
        </div>
        <div class="form-group">
          <label class="form-label">Skin / Item</label>
          <select name="item_name" class="filter-select skin-select" required>
            <option value="">Select a skin...</option>
            {{#each skins}}
              <option value="{{this}}">{{this}}</option>
            {{/each}}
          </select>
        </div>
        <button type="submit" class="btn btn-admin">Assign Skin</button>
      </form>
    {{/if}}
  </div>

  <div class="admin-form-card">
    <h3>Add Skin to Database</h3>
    <p style="color:var(--text-secondary);font-size:0.8rem;margin-bottom:1rem;">Add a new skin/item entry to the items database.</p>
    <form method="POST" action="/admin/skins/tebex" class="money-form">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <div class="form-group">
        <label class="form-label">Item / Skin Name</label>
        <input
          type="text"
          name="item_name"
          class="filter-input"
          placeholder="e.g. Wasteland Loadout Drop — The Burglar"
          required
        >
      </div>
      <div class="form-group">
        <label class="form-label">Skin Key</label>
        <input
          type="text"
          name="skin_key"
          class="filter-input"
          placeholder="e.g. wl-skin-theburglar"
          required
        >
        <span style="color:var(--text-secondary);font-size:0.75rem;margin-top:0.25rem;display:block;">This becomes <code>custom: "skin=value"</code> in the payload</span>
      </div>
      <button type="submit" class="btn btn-admin">Add to Database</button>
    </form>
  </div>

  <div class="admin-form-card">
    <h3>Available Skins ({{skins.length}})</h3>
    {{#if skins.length}}
      <div class="skin-list">
        {{#each skins}}
          <span class="skin-tag">{{this}}</span>
        {{/each}}
      </div>
    {{else if skinsError}}
      <div class="empty-state">Could not load skins.</div>
    {{else}}
      <div class="empty-state">No skins configured on the server.</div>
    {{/if}}
  </div>
</section>

{{> ban-modal}}
